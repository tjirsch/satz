#!/usr/bin/env bash
# Names gate — refuses a commit that carries a non-example identifier — then the wording
# check: one word for one thing (docs/glossary.md). Either one failing refuses the commit.
# Enable once per clone:  git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-names.sh" --staged || exit 1
"$root/scripts/check-wording.sh" --staged || exit 1
