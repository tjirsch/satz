// A template for one Google project in the folder of the workload `shop`: the id by
// the customer's naming scheme, a four-digit cost center as a label, and the owner, editor
// and viewer roles granted to three groups named after the project. One file, used two ways.
//
// AS HCL. `satz transpile simple-project.satz` writes hcl/ with the three inputs below as
// variables: `variables.tf` declares them, `terraform.tfvars` carries the example values,
// `main.tf` reads `var.<name>`, and `interface.tf` holds the organization's values. A team
// that works in OpenTofu alone takes hcl/, edits `terraform.tfvars` (or passes `-var`), and
// runs `tofu plan`; the project's id, name, label and groups follow.
//
// AS SATZ. A thin estate binds the inputs in its `params { }` and uses this file — the
// example beside this one, examples/acme/shop-dev/ — and transpiles to the same HCL with the
// bound values in `terraform.tfvars`. `satz transpile simple-project.satz --input stage=test`
// binds one for a run.
//
// The plan runs as the workload's own account, in the workload's own project, with the
// state in the workload's own bucket, and creates under the workload's own folder — what
// `presets/delegation.satz` and `presets/delegated-folders.satz` create for the delegation `shop` in the organization's
// estate and publishes as the interfaces `delegation-shop` and `shop`. The groups are not declared here: they exist in the
// customer's directory — synced from Microsoft Entra ID — before the apply, which fails on
// a group that does not.

estate simple_project

inputs {
  // the application the project serves: lowercase letters, digits and `-`
  application = "shop"
  // the stage: dev, test or prod
  stage       = "dev"
  // the four-digit cost center the project is billed to
  cost_centre = "4711"
}

params {
  // The workload's identity, as the organization's delegation pack created it for
  // `shop` and published it in the interface `delegation-shop` (`deploy_project_id`, `iac_account`,
  // `state_bucket`): the project the plan is billed to and the state lives in, the account
  // the plan runs as, the state bucket. Example values: replace them with your workload's.
  infra_project_name = "acme-deploy-shop"
  svc_iac_account    = "svc-deploy-shop"
  infra_bucket_name  = "acme-deploy-shop-state"
  // The billing account the new project is linked to. An example value: replace it.
  billing_account    = "012345-6789AB-CDEF01"
  deployment_mode    = "cloud"
}

terraform {
  backend {
    gcs {
      bucket = infra_bucket_name
      prefix = "hcl/state"
    }
  }
}

providers {
  "google" {
    alias                 = "google"
    project               = infra_project_name
    region                = "${{interface.default_region}}"
    user_project_override = true
    billing_project       = infra_project_name
  }
}

// The organization's values, read from two interface folders: the workload's identity with
// what was delegated to it (`delegation-shop`), and the folder it works in (`shop`). A value
// is read by the name of its interface folder, `${{interface.<folder>.<value>}}`. One the
// organization says once, such as `customer_shortname` or `default_region`, is the same in
// every folder and is also read without the folder's name, `${{interface.<value>}}`.
use "interfaces/incoming/delegation-shop/delegation-shop/satz/interface.satz"
use "interfaces/incoming/shop/shop/satz/interface.satz"

google_project {
  project {
    name            = "{application}-{stage}"
    project_id      = "${{interface.customer_shortname}}-{application}-{stage}"
    folder_id       = "${{interface.shop.delegated_folder}}"
    billing_account = billing_account
    labels          = { cost_centre = cost_centre }
    // The grants below are calls to this API, billed to the project itself.
    project_service = ["cloudresourcemanager.googleapis.com"]
    // One grant per role, each a resource of its own: a group's name reads the inputs, and
    // a member that reads an input is a value, never a key.
    google_project_iam_member {
      owner {
        role   = "roles/owner"
        member = "group:${{interface.customer_shortname}}-{application}-{stage}-owner@${{interface.customer_domain}}"
      }
      editor {
        role   = "roles/editor"
        member = "group:${{interface.customer_shortname}}-{application}-{stage}-editor@${{interface.customer_domain}}"
      }
      viewer {
        role   = "roles/viewer"
        member = "group:${{interface.customer_shortname}}-{application}-{stage}-viewer@${{interface.customer_domain}}"
      }
    }
  }
}
