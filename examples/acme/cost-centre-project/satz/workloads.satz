// Google projects by the customer's naming scheme, each with its cost centre as a label
// and its owner, editor and viewer roles granted to three groups named after it.
//
// This estate is a project beside the organisation's estate (examples/acme/): its own
// folder, config and state. It reads the organisation through the interface file in
// vendor/, a copy of the organisation's interfaces/common/, and writes nothing there.
//
// One entry of `workload_projects` is one Google project. The entry `shop-prod` with
// the cost centre 4711 gives, for Customer A of docs/examples.md:
//
//   project id   acme-shop-prod                      <customer_shortname>-<name>
//   parent       the organisation's workload folder
//   label        cost_centre = "4711"
//   roles/owner  group acme-shop-prod-owner          <project id>-<role>@<customer_domain>
//   roles/editor group acme-shop-prod-editor
//   roles/viewer group acme-shop-prod-viewer
//
// The groups are not declared here: they exist in the customer's directory — synced
// from Microsoft Entra ID — before the apply, which fails on a group that does not.

estate workloads

params {
  // The billing account the projects are linked to. An example value: replace it.
  billing_account = "012345-6789AB-CDEF01"
  // The Google project the provider bills its own calls to — here the organisation's
  // infrastructure project, where its estate enables the APIs creating a project needs.
  // An example value: replace it.
  quota_project   = "acme-infra-001"
  deployment_mode = "local"
  // One entry per Google project: `name` is `<application>-<stage>`, `cost_centre` four
  // digits. The request point below refuses anything else at compile.
  workload_projects = [
    { name = "shop-prod" cost_centre = "4711" },
    { name = "shop-dev" cost_centre = "4711" },
  ]
}

// The naming scheme and the cost centre, checked on every compile: a field whose value
// does not match its pattern whole is refused, naming the entry and the value.
request workload_projects {
  key         = "name"
  fields      = ["name", "cost_centre"]
  patterns    = { name = "[a-z][a-z0-9]{{1,11}}-(dev|test|prod)" cost_centre = "[0-9]{{4}}" }
  description = "A Google project: <application>-<stage>, and the four-digit cost centre it is billed to"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

providers {
  "google" {
    alias                 = "google"
    project               = quota_project
    user_project_override = true
    billing_project       = quota_project
  }
}

// The organisation's values: `${{interface.<export>}}` reads one. A value satz knows
// at compile time is written as its literal; `workload_folder`, whose number only the
// cloud knows, becomes a lookup in hcl/main.tf.
use "vendor/common/core/satz/interface.satz"

google_project {
  each workload_projects by name {
    name            = "{each.name}"
    project_id      = "${{interface.customer_shortname}}-{each.name}"
    folder_id       = "${{interface.workload_folder}}"
    billing_account = billing_account
    labels          = { cost_centre = each.cost_centre }
    // The grants below are calls to this API, billed to the project itself.
    project_service = ["cloudresourcemanager.googleapis.com"]
    google_project_iam_member {
      "group:${{interface.customer_shortname}}-{each.name}-owner@${{interface.customer_domain}}" = [
        "roles/owner",
      ]
      "group:${{interface.customer_shortname}}-{each.name}-editor@${{interface.customer_domain}}" = [
        "roles/editor",
      ]
      "group:${{interface.customer_shortname}}-{each.name}-viewer@${{interface.customer_domain}}" = [
        "roles/viewer",
      ]
    }
  }
}
