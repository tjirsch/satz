// The map: which packs make up this estate, asked as questions — so an interview
// has a path. First the day-0 params (estate-core), then these choices, then the
// questions of every pack the answers switched on.
//
//   use "presets/estate-map.satz"
//
// The map declares the choices, and at the bottom of the file one `offers` entry
// per pack in the library: the gate that switches it on, the phase that has to be
// finished before it can go in, the block its line belongs in, and — in file
// order — the order the packs can be adopted. `satz pack-graph` reads the entries,
// derives who needs whom from the packs' own param references and `ask_when`, and
// writes `presets/pack-graph.json`; an entry declares `requires` or `excludes` only
// for an edge the packs do not show. The estate carries the matching `use … when`
// lines, each written commented under its phase. `satz init`, `satz interview
// --create` and the MCP tool `satz_interview` write them; answering a choice yes in
// the interview uncomments its line. A pack switched on brings its own questions
// with it; one switched off asks nothing and emits nothing. A question that gates a
// pack cannot live in the pack it gates, which is why they all live here.
//
// The CIS baseline is the first choice and barely one: the estate exists for it,
// and its opt-in extensions are the baseline pack's own questions. It is asked
// because it is thirty organisation policies in one apply, not because an estate
// is expected to go without. Defender's plan fragments are offered with `by_hand`:
// their gates are the Defender pack's own, and their lines are written by hand
// beside the Defender line, as their headers show.
//
// Turning a pack off later destroys what it created. The `reversal` of each
// choice says so; the `blast` says how much that costs the running organisation.

pack estate_map version "2.6"

params {
  // ---- what the estate is for ---------------------------------------------
  use_cis_baseline = true

  // ---- the security-group model: exactly one ------------------------------
  security_model_s1 = true
  security_model_s2 = false

  // ---- recommended: on unless the customer says otherwise -------------------
  use_audit_logsink       = true
  use_central_alerts      = true
  use_billing_permissions = true
  use_essential_contacts  = true

  // ---- optional: off until the customer asks --------------------------------
  use_budget                    = false
  use_billing_export            = false
  use_shared_network            = false
  use_project_cis_log_alerts    = false
  use_scc_enablement            = false
  use_scc_notifications         = false
  use_scc_findings_mail         = false
  use_scc_findings_siem         = false
  use_scc_export                = false
  use_security_audit_sa         = false
  use_defender                  = false
  use_sentinel                  = false
  // Both log paths follow the Sentinel choice BY REFERENCE: a customer who
  // connects Sentinel and accepts the defaults gets the logs Sentinel exists to
  // read. Answer either one `false` to leave that path out.
  use_sentinel_auditlogs        = use_sentinel
  use_sentinel_network_logs     = use_sentinel
  use_verification_runner       = false
  // The grant follows the runner BY REFERENCE: the customer-hosted shape uses
  // both. An MSP-hosted runner lives in the MSP's estate, and the customer's
  // estate answers the grant alone `true`.
  use_verification_runner_grant = use_verification_runner
  use_exemption_tag             = false

  // ---- how the projects hear of a changed export: at most one form ------------
  interface_notice_pubsub = false
}

question use_cis_baseline {
  prompt   = "Put the CIS GCP Foundation baseline — thirty organisation policies — in this estate?"
  why      = "This is what the estate is FOR, not an addition to it: every CIS claim the compliance report makes rests on these policies, and the opt-in extensions below are gated on params this pack declares. It is asked rather than assumed because it is thirty policies at the organisation node in one apply, which goes in deliberately — after the state and the identity have moved to the service account, with its plan read first. Turning it off later takes every one of those policies off the organisation."
  reversal = recreate
  blast    = high
}

question oneof security_model {
  prompt   = "Which security-group model does this customer run?"
  why      = "Splitting network authority out later means a new group, membership moves and re-granted roles."
  reversal = state_surgery
  blast    = low
  required = true
  option security_model_s1 { label = "S1 — five admin groups; network authority sits with project admins" why = "A small team that separates org admins, project admins and security roles, and nothing more." }
  option security_model_s2 { label = "S2 — S1 plus a distinct network-admins group" why = "For a customer with a separate network team." }
}

question use_audit_logsink {
  prompt   = "Archive the organisation's audit logs into a bucket in a logging project?"
  why      = "The compliance archive: every Admin Activity, Data Access, System Event and Policy log, organisation-wide, in one bucket with a retention. Without it there is no record to answer an auditor with. Turning it off later destroys the logging project and the archive."
  reversal = recreate
  blast    = high
}

question use_central_alerts {
  prompt   = "Alert on the CIS log events — ownership, IAM, firewall, route, network, bucket and SQL changes — organisation-wide?"
  why      = "CIS 2.5–2.12 as eight metrics and alert policies in the logging project, into one mailbox. Needs the audit-log archive above: it lives in that project. Turning it off later destroys the alerting bucket and its policies, and with them thirty days of alert history."
  reversal = recreate
  blast    = low
}

question use_billing_permissions {
  prompt   = "Grant the billing-admins group its roles on the billing account?"
  why      = "billing.admin and billing.costsManager for the model's billing-admins group, and use/view for the domain. Without it nobody but the first admin and the IaC account can see or move spend."
  reversal = edit
  blast    = low
}

question use_essential_contacts {
  prompt   = "Register the organisation's essential contact?"
  why      = "Google's suspension, security and legal notices need an address to go to. Without a contact they go to nobody, and the first sign of a problem is the consequence."
  reversal = recreate
  blast    = low
}

question use_budget {
  prompt   = "Put a budget with alerts at 50, 80 and 100 % on the infrastructure billing account?"
  why      = "The one alarm on runaway cost. The pack carries an import-id placeholder for adopting a budget that already exists — delete it for a fresh one, as its header says."
  reversal = recreate
  blast    = none
}

question use_shared_network {
  prompt   = "Run a shared VPC for the projects: a host project, one network, and a firewall policy whose subnets and rules the projects request?"
  why      = "Projects then run in one network the estate owns instead of each building its own: a project asks for a subnet or a firewall rule by pull request, the estate applies it, and the interface publishes it. Turning it off later destroys the host project, the network and every subnet and rule in it, and cuts off every project attached to it."
  reversal = recreate
  blast    = high
}

question use_billing_export {
  prompt   = "Export Cloud Billing usage and cost data to BigQuery, in a project of its own?"
  why      = "A budget says when a threshold is crossed; the export says what the money went on, per project, per SKU, per day. It creates a project and a dataset, and it allows Google's export account past domain-restricted sharing while it is on. Switching the export itself on is a console step Cloud Billing has no API for, which the pack's notice names. Turning the pack off later destroys the project and the spend history in it."
  reversal = recreate
  blast    = low
}

question use_project_cis_log_alerts {
  prompt   = "Alert on the CIS log events inside one project of its own as well?"
  why      = "The central alerts cover every project from the logging project. This pack puts the same eight metrics and alert policies, and a channel, into ONE project — for a project with its own on-call, delegated ownership or tenant isolation, or an organisation without the central logging bucket. One project per line: a second project is a fork, because the labels are fixed. Turning it off later destroys the project's metrics, policies and channel, and their alert history."
  reversal = recreate
  blast    = low
}

question use_scc_enablement {
  prompt    = "Turn Security Command Center on for the organisation?"
  why       = "Google's own detector platform: it watches every project for misconfigurations, leaked keys, crypto-mining and attack patterns, and nothing else in this library replaces it. The tier this library assumes is Premium, and it is not free: the charge is per covered resource per hour, not a share of the bill — at organisation level 0.0057 USD per instance-hour for Compute Engine, Cloud SQL and App Engine Flex, per vCPU-hour for Cloud Run and AlloyDB, 0.20 USD per container image scanned, plus Cloud Storage operation and BigQuery analysis rates (https://cloud.google.com/security-command-center/pricing). Because it follows the NUMBER of resources and not their size, it lands near the 5% of Google Cloud spend Google charges for the equivalent annual subscription on an estate of ordinary machines, and at 10% or more on an estate of many small ones. The 30-day trial is started in the console and becomes pay-as-you-go by itself; pay-as-you-go carries no commitment, and putting the organisation back to Standard stops the charge. Answering yes here declares the step that switches the detectors on — the tier itself is activated in the console."
  reversal  = edit
  blast     = low
  recommend = true
}

question use_scc_notifications {
  prompt   = "Publish findings to a Pub/Sub topic, for a SIEM or a ticket system to pick up?"
  why      = "Findings that stay in the console are read when somebody remembers to look. The topic is the one place another system can read them from as they are raised. Whoever can read the topic reads every finding in the organisation."
  reversal = edit
  blast    = low
  ask_when = use_scc_enablement
}

question use_scc_findings_mail {
  prompt   = "Mail a security address when findings arrive?"
  why      = "For an organisation with nothing subscribed to the topic — and a topic nobody subscribes to drops every message it receives. This adds a subscription that keeps seven days, an e-mail channel and an alert that fires when findings reach the topic. The mail says findings arrived and links to them; the finding itself stays in the topic, the console and the export. Off when a SIEM already reads the topic."
  reversal = edit
  blast    = low
  ask_when = use_scc_notifications
}

question use_scc_findings_siem {
  prompt   = "Let an external SIEM pull findings off the topic?"
  why      = "For a customer whose security team works in Sentinel, Defender for Cloud, Splunk or QRadar rather than in a mailbox. It adds the connector's own pull subscription and `roles/pubsub.subscriber` for the identity it reads as, which is asked — without that grant a connector authenticates and reads nothing. This and the mailbox are not exclusive: the SIEM ingests every finding, the mailbox is told they are arriving."
  reversal = edit
  blast    = low
  ask_when = use_scc_notifications
}

question use_scc_export {
  prompt   = "Keep findings in BigQuery, so they can be queried months later?"
  why      = "A notification tells somebody now; the export answers what the organisation looked like in March. Whoever can read the dataset reads every finding the organisation has ever raised, and the dataset's location cannot be changed afterwards."
  reversal = edit
  blast    = low
  ask_when = use_scc_enablement
}

question use_security_audit_sa {
  prompt   = "Create a read-only security-audit service account with an impersonation group for auditors?"
  why      = "Auditor access without keys and without remediation rights. Turning it off later removes the account and every auditor's access with it."
  reversal = recreate
  blast    = low
}

question use_defender {
  prompt   = "Onboard Microsoft Defender for Cloud through workload identity federation to the customer's Entra tenant?"
  why      = "Only for a customer who runs Defender. It needs the two ids from Microsoft's onboarding script and creates a workload identity pool; turning it off later removes the pool and Defender loses its connector. The plan fragments are added by hand per that pack's header."
  reversal = recreate
  blast    = high
}

question use_sentinel {
  prompt   = "Connect Microsoft Sentinel to this organisation?"
  why      = "Sentinel reads Google Cloud logs by pulling them from Pub/Sub, federated through workload identity — no service-account key leaves the organisation. This creates the federation half: the pool named after the customer's Entra tenant, the provider that trusts Microsoft, and the account Sentinel acts as. Onboarding is two-sided: the connector in Azure is configured with what this creates, and nothing flows until both halves are done. Turning it off later leaves the connector authenticated against a pool that no longer exists."
  reversal = recreate
  blast    = low
}

question use_sentinel_auditlogs {
  prompt   = "Send the organisation's audit logs to Sentinel?"
  why      = "What a SIEM is for: who did what, organisation-wide, with `include_children` so a project created tomorrow is covered. On with Sentinel, because a connector with no audit logs answers no question anybody asks it. The one cost decision inside it is asked separately — Data Access logs are most of the volume and Sentinel bills by the gigabyte ingested."
  reversal = recreate
  blast    = low
  ask_when = use_sentinel
}

question use_sentinel_network_logs {
  prompt   = "Send the network streams too — VPC flow logs, firewall, DNS queries, Cloud NAT?"
  why      = "Each of these is EMPTY until somebody enables that feature on a subnet, a firewall rule, a DNS policy or a NAT gateway, and Google charges nothing to route logs, so a sink for a feature nobody enabled costs nothing. Switching them off therefore saves nothing; what it costs is the day somebody enables flow logs and finds Sentinel was not watching. On with Sentinel. The volume once a feature IS on is real and lands on Sentinel's ingestion bill — an estate can leave one stream out with a `suppress`."
  reversal = recreate
  blast    = low
  ask_when = use_sentinel
}

question use_verification_runner {
  prompt   = "Run continuous verification from this estate's own project — transpile --check on every push, report-compliance every night?"
  why      = "The customer-hosted shape: Cloud Build triggers and a runner account in the infrastructure project. The grant that lets the runner read as the estate is the next choice, and follows this one. An MSP-hosted runner lives in the MSP's estate: answer this one no here and the grant yes."
  reversal = recreate
  blast    = low
}

question use_verification_runner_grant {
  prompt   = "Let a verification runner act as this estate's IaC service account?"
  why      = "One binding: the runner's account may mint tokens for the estate's account, the right a human operator holds through the IaC users group. It follows the runner choice, because a runner in this estate needs it; with the runner in another estate — an MSP's — it is answered on its own, and the grant's own question names that runner's account. Whoever holds the runner account reads the estate as its service account."
  reversal = edit
  blast    = low
}

question use_exemption_tag {
  prompt   = "Create the organisation tag that lets a policy exempt named resources?"
  why      = "An organisation policy is all-or-nothing per node: letting ONE service account or ONE project out of a control today means lowering the policy for a whole folder and raising it again afterwards, a window during which nothing is enforced and which nobody remembers to close. A Resource Manager tag is IAM-governed and an organisation policy's rule can condition on it, so the policy stays enforced everywhere and named resources are let out one at a time — visible in the compliance report and listable organisation-wide through Cloud Asset Inventory. Creating the tag exempts nothing on its own: a binding does, and each binding is written in the estate with its owner and its reason. Before granting any exemption, ask whether the consumer needs it at all — a workload in Google Cloud, a Cloud Run service and external CI can all federate instead."
  reversal = edit
  blast    = none
}

question oneof interface_notice {
  prompt   = "How do the projects that read this estate's interface hear that an exported value changed?"
  why      = "The projects beside the estate read its exports through interfaces/, in their own state and their own pipelines. Without a notice they learn of a changed folder or project on their next plan, or never. The choice has one option per delivery form, and none is an answer: Pub/Sub is the one satz has. Turning a form off later removes what it created, and every project that listens to it stops hearing."
  reversal = edit
  blast    = low
  option interface_notice_pubsub { label = "Pub/Sub — a message on a topic in the infrastructure project" why = "A bucket holds the exported values as one JSON object, and a storage notification publishes one message to a topic for every apply that changes one. A project subscribes in its own state: a push to its CI's webhook or a pull from a runner." }
}

// ---- what the library offers, in the order the packs can be adopted ---------
// One entry per pack. `when` is the gate its line carries; `phase` opens a group
// of lines and says what has to be finished before they can go in; `block` names
// the resource type map the line is written inside, for a pack that is a bare
// list of labelled bodies; `by_hand` offers a pack whose line is written by hand,
// with the reason. Every other line stands at the top level of the estate, in the
// order of the entries below. `requires` and `excludes` name the edges the packs
// do not show by their param references — `satz pack-graph` derives the rest and
// refuses a declared edge it can derive.

offers "presets/estate-map.satz" {
  phase = """once the estate runs as the service account — the map, which declares the questions
every line below is gated on. This is the one to uncomment first."""
}

offers "presets/security-group-models/s1-security-groups.satz" {
  when  = security_model_s1
  phase = """once the map is in — the security-group model, whose groups later grants name.
Exactly one of the two."""
}

offers "presets/security-group-models/s2-security-groups.satz" {
  when = security_model_s2
}

// It grants to the model's billing-admins group by the group's address, which is
// a literal, not a param the model declares — so the edge is declared. Either
// model satisfies it: the two exclude one another.
offers "presets/billing-account-permissions.satz" {
  when  = use_billing_permissions
  phase = """once the groups exist — this grants to the model's billing-admins group by name, so
the grant has nothing to land on until they are applied"""
  requires = [
    "presets/security-group-models/s1-security-groups.satz",
    "presets/security-group-models/s2-security-groups.satz",
  ]
}

offers "presets/organization-budget.satz" {
  when  = use_budget
  phase = "once the estate runs as the service account — these stand alone"
}

offers "presets/billing-export.satz" {
  when = use_billing_export
}

offers "presets/shared-network.satz" {
  when  = use_shared_network
  phase = "once the estate runs as the service account and the projects are onboarded — the network they request subnets and rules in"
}

offers "presets/security-audit/sa-security-audit.satz" {
  when = use_security_audit_sa
}

offers "presets/scc/scc-service-enablement.satz" {
  when = use_scc_enablement
}

offers "presets/monitoring/project-cis-log-alerts.satz" {
  when = use_project_cis_log_alerts
}

offers "presets/essential-contacts-organization.satz" {
  when  = use_essential_contacts
  phase = "once the estate runs as the service account — one contact for Google's notices"
  block = "google_essential_contacts_contact"
}

offers "presets/monitoring/organization-audit-logsink.satz" {
  when  = use_audit_logsink
  phase = """once the estate runs as the service account — the audit archive, which every later
logging pack points at"""
}

offers "presets/monitoring/organization-cis-log-alerts-central.satz" {
  when  = use_central_alerts
  phase = """once the archive exists — the alert project defaults to the logsink's, so this does
not compile without it"""
}

offers "presets/cis/CIS-GCP-Foundation-4.0.satz" {
  when  = use_cis_baseline
  phase = """once the estate runs as the service account — the CIS baseline, what the estate is
for and what everything below extends. Thirty organisation policies in one apply,
so it goes in on its own, with its plan read before it is applied."""
}

offers "presets/cis/block-project-ssh-keys.satz" {
  when  = cis_block_project_ssh_keys
  phase = """the baseline's own extensions, gated on params it declares, so they do not compile
without it. Each restricts what may be created; two are on by default (DNS query
logging, and the admin ports closed to the internet)."""
}

offers "presets/cis/shielded-vm.satz" {
  when = cis_require_shielded_vm
}

offers "presets/cis/dns-logging.satz" {
  when = cis_dns_logging
}

offers "presets/cis/confidential-computing.satz" {
  when = cis_confidential_computing
}

offers "presets/cis/cloud-sql.satz" {
  when = cis_cloud_sql_hardening
}

offers "presets/cis/cmek.satz" {
  when = cis_cmek_required
}

offers "presets/cis/api-key-services.satz" {
  when = cis_api_key_services
}

offers "presets/cis/bucket-retention.satz" {
  when = cis_bucket_retention
}

offers "presets/cis/access-approval.satz" {
  when = cis_access_approval
}

offers "presets/cis/internet-ssh-rdp.satz" {
  when = cis_block_internet_ssh_rdp
}

offers "presets/cis/cloud-sql-iam-and-deletion-protection.satz" {
  when = cis_cloud_sql_iam_and_deletion_protection
}

// A dry-run twin declares the same policies as its enforcing extension, so the
// two never go in together.
offers "presets/cis/api-key-services-dry-run.satz" {
  when     = cis_api_key_services_dry_run
  phase    = """INSTEAD of the enforcing extension above it, never beside it. A dry run declares the
same policy with `dry_run_spec`: Google logs every action it would have blocked and
blocks none, so the violation count sizes the control against this organisation
before it bites. Nothing is enforced while it runs."""
  excludes = ["presets/cis/api-key-services.satz"]
}

offers "presets/cis/block-project-ssh-keys-dry-run.satz" {
  when     = cis_block_project_ssh_keys_dry_run
  excludes = ["presets/cis/block-project-ssh-keys.satz"]
}

offers "presets/cis/bucket-retention-dry-run.satz" {
  when     = cis_bucket_retention_dry_run
  excludes = ["presets/cis/bucket-retention.satz"]
}

offers "presets/cis/cloud-sql-dry-run.satz" {
  when     = cis_cloud_sql_hardening_dry_run
  excludes = ["presets/cis/cloud-sql.satz"]
}

offers "presets/cis/cloud-sql-iam-and-deletion-protection-dry-run.satz" {
  when     = cis_cloud_sql_iam_and_deletion_protection_dry_run
  excludes = ["presets/cis/cloud-sql-iam-and-deletion-protection.satz"]
}

offers "presets/cis/confidential-computing-dry-run.satz" {
  when     = cis_confidential_computing_dry_run
  excludes = ["presets/cis/confidential-computing.satz"]
}

offers "presets/scc/scc-notifications.satz" {
  when  = use_scc_notifications
  phase = """once Security Command Center is switched on — findings have to exist before anything
can carry them"""
}

offers "presets/scc/scc-export.satz" {
  when = use_scc_export
}

offers "presets/scc/scc-findings-siem.satz" {
  when  = use_scc_findings_siem
  phase = "once the findings topic exists — this reads from it"
}

offers "presets/scc/scc-findings-mail.satz" {
  when  = use_scc_findings_mail
  phase = "once the central alerts are in as well — the mailbox defaults to their address"
}

offers "presets/integrations/microsoft-defender-for-cloud.satz" {
  when  = use_defender
  phase = """once the estate runs as the service account — Defender's plan fragments are added by
hand once this line is in; see that pack's header"""
}

offers "presets/integrations/microsoft-defender-for-cloud-cspm.satz" {
  when    = mdc_plan_cspm
  by_hand = "a Defender plan fragment, written beside the Defender line once the plan is licensed, as that pack's header shows"
}

offers "presets/integrations/microsoft-defender-for-cloud-cspm-role-default.satz" {
  when    = mdc_cspm_default_access
  by_hand = "the CSPM plan's custom role in the default access mode, written with the plan fragment"
}

offers "presets/integrations/microsoft-defender-for-cloud-cspm-role-least-privilege.satz" {
  when    = mdc_cspm_least_privilege
  by_hand = "the CSPM plan's custom role in the least-privilege mode, written with the plan fragment"
}

offers "presets/integrations/microsoft-sentinel.satz" {
  when  = use_sentinel
  phase = "once the audit archive exists — Sentinel's project defaults to the logsink's"
}

offers "presets/integrations/microsoft-sentinel-auditlogs.satz" {
  when  = use_sentinel_auditlogs
  phase = "once Sentinel's federation is in — these read as the account it creates"
}

offers "presets/integrations/microsoft-sentinel-network-logs.satz" {
  when = use_sentinel_network_logs
}

offers "presets/ci/verification-runner.satz" {
  when  = use_verification_runner
  phase = """once the estate runs as the service account — the runner, then the grant that trusts
it by naming the runner's own account"""
}

offers "presets/ci/verification-runner-grant.satz" {
  when = use_verification_runner_grant
}

offers "presets/exemptions/exemption-tag.satz" {
  when  = use_exemption_tag
  phase = """any time after the organisation policies — it creates the tag an exemption is bound to
and exempts nothing on its own. The BINDING that lets one resource out, and the
condition on the constraint that honours it, are the estate's to write; the pack's
header shows both"""
}

offers "presets/interface-notice.satz" {
  when  = interface_notice_pubsub
  phase = "once the estate exports what projects read — the notice publishes when an export changes"
}
