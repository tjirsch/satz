// GENERATED by scripts/build_dry_run_fragments.py from bucket-retention.satz — do not edit.
//
//   use "presets/cis/bucket-retention-dry-run.satz" when cis_bucket_retention_dry_run
//
// The dry-run twin of bucket-retention.satz. Google evaluates every rule below, writes a
// violation to the audit log for each action it WOULD have blocked, and blocks
// nothing — so the organisation's own numbers answer "will this break us?" before
// the control is enforced. Read them in Cloud Logging:
//
//   protoPayload.metadata."@type"="type.googleapis.com/google.cloud.audit.OrgPolicyViolationInfo"
//
// Promote by switching cis_bucket_retention_dry_run off
// and cis_bucket_retention on. Both on at once is refused:
// the estate would declare the same policy twice, once measuring and once blocking.
//
// This fragment carries NO claim. A dry run discharges no control while it runs, and
// `require` reports the control as unmet, which is the truth.

pack cis_extensions.bucket_retention_dry_run version "1.3"

params {
  // acknowledges the notice below: the estate binds it true once `satz adopt` has run
  cis_bucket_retention_dry_run_adopted = false

  // Durations, in SECONDS, a bucket retention policy may use. The default is
  // the 400 days the audit-logsink pack retains by default; add the others the
  // estate legitimately uses before enforcing.
  allowed_bucket_retention_seconds = [
    "34560000",
  ]
}

notice cis_bucket_retention_dry_run_adopted {
  text   = "Google may already hold a policy this pack declares on the organisation, set by an administrator or by default, and an apply that creates a policy that exists stops on 409 POLICY_ALREADY_EXISTS. Run satz adopt once the pack is on, so every live policy is in the state before the apply; with --import it binds this param itself when it has run."
  run    = "satz adopt <estate> --execute --import"
  before = apply
}

question allowed_bucket_retention_seconds {
  prompt   = "The retention durations, in seconds, a bucket's retention policy may use"
  why      = "The default is the 400 days the audit-logsink pack retains. Every bucket in the organisation with a retention policy on another duration can no longer be updated once this is enforced, so the estate's other durations have to be listed first."
  reversal = edit
  blast    = low
}

google_org_policy_policy {
  "storage-managed-retentionPolicySeconds" {
    name   = "storage.managed.retentionPolicySeconds"
    parent = "organizations/{customer_organization_id}"
    dry_run_spec {
      rules = [
        {
          enforce = "TRUE"
          parameters = {
            allowedRetentionPeriods = allowed_bucket_retention_seconds
          }
        },
      ]
    }
  }
}

// Superseded legacy twin, declared OFF — see the section of the same name in
// CIS-GCP-Foundation-4.0.satz for why absence is not enough. `reset = true`
// restores the constraint default, which is ALLOW here.
google_org_policy_policy {
  "storage-retentionPolicySeconds" {
    name   = "storage.retentionPolicySeconds"
    parent = "organizations/{customer_organization_id}"
    spec {
      reset = true
    }
  }
}
