// CIS 6.5 and 6.6/6.7 — Cloud SQL network exposure.
//
//   use "presets/cis/cloud-sql.satz" when cis_cloud_sql_hardening
//
// Opt-in because an estate with existing Cloud SQL instances on public IPs loses
// connectivity the moment this is enforced; the private path has to exist
// first. Note the renumbering: public IP is §6.6 in 4.0 and §6.7 in 5.0, while
// authorized networks stays §6.5 in both.
//
// The constraint name and its shape were verified against a live
// organisation's OrgPolicy `ListConstraints`, not transcribed.

pack cis_extensions.cloud_sql version "1.4"
params {
  // acknowledges the notice below: the estate binds it true once `satz adopt` has run
  cis_cloud_sql_hardening_adopted = false
}

notice cis_cloud_sql_hardening_adopted {
  text     = "Google may already hold a policy this pack declares on the organisation, set by an administrator or by default, and an apply that creates a policy that exists stops on 409 POLICY_ALREADY_EXISTS. Run satz adopt once the pack is on, so every live policy is in the state before the apply; with --import it binds this param itself when it has run."
  run      = "satz adopt <estate> --execute --import"
  severity = error
}

google_org_policy_policy {
  "sql-managed-restrictAuthorizedNetworks" {
    name   = "sql.managed.restrictAuthorizedNetworks"
    parent = "organizations/{customer_organization_id}"
    spec {
      rules = [
        {
          enforce = "TRUE"
        },
      ]
    }
  }
}

google_org_policy_policy {
  "sql-managed-restrictPublicIp" {
    name   = "sql.managed.restrictPublicIp"
    parent = "organizations/{customer_organization_id}"
    spec {
      rules = [
        {
          enforce = "TRUE"
        },
      ]
    }
  }
}

// Superseded legacy twin, declared OFF — see the section of the same name in
// CIS-GCP-Foundation-4.0.satz for why absence is not enough. `reset = true`
// restores the constraint default, which is ALLOW here.
google_org_policy_policy {
  "sql-restrictAuthorizedNetworks" {
    name   = "sql.restrictAuthorizedNetworks"
    parent = "organizations/{customer_organization_id}"
    spec {
      reset = true
    }
  }
}

// Superseded legacy twin, declared OFF — see the section of the same name in
// CIS-GCP-Foundation-4.0.satz for why absence is not enough. `reset = true`
// restores the constraint default, which is ALLOW here.
google_org_policy_policy {
  "sql-restrictPublicIp" {
    name   = "sql.restrictPublicIp"
    parent = "organizations/{customer_organization_id}"
    spec {
      reset = true
    }
  }
}

claim "cis-gcp" "4.0" "6.5" implements {
  resources = [
    "google_org_policy_policy.sql_managed_restrictAuthorizedNetworks",
  ]
  interpretation = "No Cloud SQL instance may carry an authorized network that whitelists every public address."
  gcloud = [
    """cat > policy.yaml <<'EOF'
name: organizations/ORGANIZATION_ID/policies/sql.managed.restrictAuthorizedNetworks
spec:
  rules:
  - enforce: true
EOF""",
    "gcloud org-policies set-policy policy.yaml",
    "gcloud org-policies reset sql.restrictAuthorizedNetworks --organization=ORGANIZATION_ID",
  ]
  gcloud_check = [
    "gcloud org-policies describe sql.managed.restrictAuthorizedNetworks --organization=ORGANIZATION_ID --effective",
    "gcloud sql instances list --project=PROJECT_ID --format='table(name,settings.ipConfiguration.authorizedNetworks[].value.list())'",
  ]
  risk = "An authorized network of 0.0.0.0/0 admits connection attempts to the database from every address on the internet."
}
claim "cis-gcp" "5.0" "6.5" implements {
  resources = [
    "google_org_policy_policy.sql_managed_restrictAuthorizedNetworks",
  ]
  interpretation = "As for 4.0 §6.5 (5.0 §6.5, unchanged)."
  gcloud = [
    """cat > policy.yaml <<'EOF'
name: organizations/ORGANIZATION_ID/policies/sql.managed.restrictAuthorizedNetworks
spec:
  rules:
  - enforce: true
EOF""",
    "gcloud org-policies set-policy policy.yaml",
    "gcloud org-policies reset sql.restrictAuthorizedNetworks --organization=ORGANIZATION_ID",
  ]
  gcloud_check = [
    "gcloud org-policies describe sql.managed.restrictAuthorizedNetworks --organization=ORGANIZATION_ID --effective",
    "gcloud sql instances list --project=PROJECT_ID --format='table(name,settings.ipConfiguration.authorizedNetworks[].value.list())'",
  ]
  risk = "An authorized network of 0.0.0.0/0 admits connection attempts to the database from every address on the internet."
}

claim "cis-gcp" "4.0" "6.6" implements {
  resources = [
    "google_org_policy_policy.sql_managed_restrictPublicIp",
  ]
  interpretation = "Cloud SQL instances may not be given public IP addresses."
  gcloud = [
    """cat > policy.yaml <<'EOF'
name: organizations/ORGANIZATION_ID/policies/sql.managed.restrictPublicIp
spec:
  rules:
  - enforce: true
EOF""",
    "gcloud org-policies set-policy policy.yaml",
    "gcloud org-policies reset sql.restrictPublicIp --organization=ORGANIZATION_ID",
  ]
  gcloud_check = [
    "gcloud org-policies describe sql.managed.restrictPublicIp --organization=ORGANIZATION_ID --effective",
    "gcloud sql instances list --project=PROJECT_ID --format='table(name,databaseVersion,settings.ipConfiguration.ipv4Enabled)'",
  ]
  risk = "A Cloud SQL instance with a public IP address is reachable from the internet and exposed to password guessing and to every flaw in its engine."
}
claim "cis-gcp" "5.0" "6.7" implements {
  resources = [
    "google_org_policy_policy.sql_managed_restrictPublicIp",
  ]
  interpretation = "As for 4.0 §6.6 — 5.0 §6.7 (5.0 inserted 6.6 IAM database authentication)."
  gcloud = [
    """cat > policy.yaml <<'EOF'
name: organizations/ORGANIZATION_ID/policies/sql.managed.restrictPublicIp
spec:
  rules:
  - enforce: true
EOF""",
    "gcloud org-policies set-policy policy.yaml",
    "gcloud org-policies reset sql.restrictPublicIp --organization=ORGANIZATION_ID",
  ]
  gcloud_check = [
    "gcloud org-policies describe sql.managed.restrictPublicIp --organization=ORGANIZATION_ID --effective",
    "gcloud sql instances list --project=PROJECT_ID --format='table(name,databaseVersion,settings.ipConfiguration.ipv4Enabled)'",
  ]
  risk = "A Cloud SQL instance with a public IP address is reachable from the internet and exposed to password guessing and to every flaw in its engine."
}
