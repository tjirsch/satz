// GENERATED by scripts/build_dry_run_fragments.py from api-key-services.satz — do not edit.
//
//   use "presets/cis/api-key-services-dry-run.satz" when cis_api_key_services_dry_run
//
// The dry-run twin of api-key-services.satz. Google evaluates every rule below, writes a
// violation to the audit log for each action it WOULD have blocked, and blocks
// nothing — so the organisation's own numbers answer "will this break us?" before
// the control is enforced. Read them in Cloud Logging:
//
//   protoPayload.metadata."@type"="type.googleapis.com/google.cloud.audit.OrgPolicyViolationInfo"
//
// Promote by switching cis_api_key_services_dry_run off
// and cis_api_key_services on. Both on at once is refused:
// the estate would declare the same policy twice, once measuring and once blocking.
//
// This fragment carries NO claim. A dry run discharges no control while it runs, and
// `require` reports the control as unmet, which is the truth.

pack cis_extensions.api_key_services_dry_run version "1.2"

params {
  // acknowledges the notice below: the estate binds it true once `satz adopt` has run
  cis_api_key_services_dry_run_adopted = false

  // The services an API key may target. Empty means no service-account API key
  // may be created at all — the strictest reading, and a legitimate one.
  allowed_api_key_services = []
}

notice cis_api_key_services_dry_run_adopted {
  text   = "Google may already hold a policy this pack declares on the organisation, set by an administrator or by default, and an apply that creates a policy that exists stops on 409 POLICY_ALREADY_EXISTS. Run satz adopt once the pack is on, so every live policy is in the state before the apply; with --import it binds this param itself when it has run."
  run    = "satz adopt <estate> --execute --import"
  before = apply
}

question allowed_api_key_services {
  prompt   = "The services an API key bound to a service account may target"
  why      = "The pack cannot know which APIs the customer's applications call. Empty is a legitimate answer — no such key may be created at all — but it has to be the customer's answer: every key whose targets are not in this list stops working the moment the control is enforced."
  reversal = edit
  blast    = high
}

google_org_policy_policy {
  "iam-managed-disableServiceAccountApiKeyCreation" {
    name   = "iam.managed.disableServiceAccountApiKeyCreation"
    parent = "organizations/{customer_organization_id}"
    dry_run_spec {
      rules = [
        {
          enforce = "TRUE"
          parameters = {
            allowedServices = allowed_api_key_services
          }
        },
      ]
    }
  }
}
