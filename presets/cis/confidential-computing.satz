// CIS 4.11 — Confidential Computing.
//
//   use "presets/cis/confidential-computing.satz" when cis_confidential_computing
//
// Opt-in because Confidential VMs are limited to particular machine families and cost
// more; enforcing this org-wide stops most ordinary workloads from starting.
// CIS rates it Level 2 for the same reason.
//
// The constraint name and its shape were verified against a live
// organisation's OrgPolicy `ListConstraints`, not transcribed.

pack cis_extensions.confidential_computing version "1.3"
params {
  // acknowledges the notice below: the estate binds it true once `satz adopt` has run
  cis_confidential_computing_adopted = false
}

notice cis_confidential_computing_adopted {
  text     = "Google may already hold a policy this pack declares on the organisation, set by an administrator or by default, and an apply that creates a policy that exists stops on 409 POLICY_ALREADY_EXISTS. Run satz adopt once the pack is on, so every live policy is in the state before the apply; with --import it binds this param itself when it has run."
  run      = "satz adopt <estate> --execute --import"
  severity = error
}

google_org_policy_policy {
  "compute-managed-restrictNonConfidentialComputing" {
    name   = "compute.managed.restrictNonConfidentialComputing"
    parent = "organizations/{customer_organization_id}"
    spec {
      rules = [
        {
          enforce = "TRUE"
        },
      ]
    }
  }
}

claim "cis-gcp" "4.0" "4.11" implements {
  resources = [
    "google_org_policy_policy.compute_managed_restrictNonConfidentialComputing",
  ]
  interpretation = "Instances must run as Confidential VMs, so memory stays encrypted in use."
  gcloud = [
    """cat > policy.yaml <<'EOF'
name: organizations/ORGANIZATION_ID/policies/compute.managed.restrictNonConfidentialComputing
spec:
  rules:
  - enforce: true
EOF""",
    "gcloud org-policies set-policy policy.yaml",
  ]
  gcloud_check = [
    "gcloud org-policies describe compute.managed.restrictNonConfidentialComputing --organization=ORGANIZATION_ID --effective",
    "gcloud compute instances list --project=PROJECT_ID --format='table(name,zone,confidentialInstanceConfig.enableConfidentialCompute)'",
  ]
  risk = "An instance's memory is not encrypted while in use, so its data is exposed to anyone who can read the host's memory."
}
claim "cis-gcp" "5.0" "4.11" implements {
  resources = [
    "google_org_policy_policy.compute_managed_restrictNonConfidentialComputing",
  ]
  interpretation = "As for 4.0 §4.11 (5.0 §4.11, unchanged)."
  gcloud = [
    """cat > policy.yaml <<'EOF'
name: organizations/ORGANIZATION_ID/policies/compute.managed.restrictNonConfidentialComputing
spec:
  rules:
  - enforce: true
EOF""",
    "gcloud org-policies set-policy policy.yaml",
  ]
  gcloud_check = [
    "gcloud org-policies describe compute.managed.restrictNonConfidentialComputing --organization=ORGANIZATION_ID --effective",
    "gcloud compute instances list --project=PROJECT_ID --format='table(name,zone,confidentialInstanceConfig.enableConfidentialCompute)'",
  ]
  risk = "An instance's memory is not encrypted while in use, so its data is exposed to anyone who can read the host's memory."
}
