// The S1 security group model in ONE file: the five admin groups and their
// organization-level role grants.
//
// Resource-type sections may repeat across files with distinct ids, so a typed
// pack sits beside the estate's own groups and grants. The same groups and
// grants as s1-group-definitions + s1-group-permissions, the spelling as two
// content packs `use`d under a resource type; an estate takes ONE of the two
// spellings, never both.
//
//   use "presets/security-group-models/s1-security-groups.satz"
//
// To adopt groups that already exist in the tenant:
//   satz adopt <estate> --only google_cloud_identity_group --execute
// Groups are looked up by email; no ids are hard-coded here (tenant-specific).
// Memberships are NOT part of this pack: presets define groups,
// humans grant membership.

pack s1_security_groups version "1.1"

params {
  gcp_organization_admins_name = "gcp-organization-admins"
  gcp_project_admins_name      = "gcp-project-admins"
  gcp_security_admins_name     = "gcp-security-admins"
  gcp_security_viewers_name    = "gcp-security-viewers"
  gcp_billing_admins_name      = "gcp-billing-admins"
}

// ---- what a customer decides, asked -------------------------------------------
// The five group names. Each is a naming convention with a sensible default —
// and each is a group's identity, so changing one later is a new group, moved
// members and re-granted roles. Accepting the defaults is one pass.

question gcp_organization_admins_name {
  prompt   = "The organization admins group's name (the local part; the customer domain is added)"
  why      = "The address is the group's identity: renaming it later means a new group, every member moved by hand and every role re-granted. This group holds the organisation's highest roles."
  reversal = recreate
  blast    = low
}

question gcp_project_admins_name {
  prompt   = "The project admins group's name (the local part; the customer domain is added)"
  why      = "The address is the group's identity: renaming it later means a new group, every member moved by hand and every role re-granted."
  reversal = recreate
  blast    = low
}

question gcp_security_admins_name {
  prompt   = "The security admins group's name (the local part; the customer domain is added)"
  why      = "The address is the group's identity: renaming it later means a new group, every member moved by hand and every role re-granted."
  reversal = recreate
  blast    = low
}

question gcp_security_viewers_name {
  prompt   = "The security viewers group's name (the local part; the customer domain is added)"
  why      = "The address is the group's identity: renaming it later means a new group, every member moved by hand and every role re-granted."
  reversal = recreate
  blast    = low
}

question gcp_billing_admins_name {
  prompt   = "The billing admins group's name (the local part; the customer domain is added)"
  why      = "The address is the group's identity: renaming it later means a new group, every member moved by hand and every role re-granted."
  reversal = recreate
  blast    = low
}

google_cloud_identity_group {
  "{gcp_organization_admins_name}" {
    lifecycle { ignore_changes = ["initial_group_config"] }
    display_name = "GCP-Organization Admins"
    description  = "Permissions merged from default roles for\nOrganization administrators, Hybrid Connectivity administrators,\nLogging-monitoring administrators and Network administrators.\n"
    owner        = ["{svc_iac_account}@{infra_project_name}.iam.gserviceaccount.com"]
  }

  "{gcp_project_admins_name}" {
    lifecycle { ignore_changes = ["initial_group_config"] }
    display_name = "GCP-Project Admins"
    description  = "Permissions allow Day2Day Project Administration across all projects+\nHybrid Connectivity administrators, Logging-monitoring administrators and\nNetwork administrators.\n"
    owner        = ["{svc_iac_account}@{infra_project_name}.iam.gserviceaccount.com"]
  }

  "{gcp_security_admins_name}" {
    lifecycle { ignore_changes = ["initial_group_config"] }
    display_name = "GCP-Security Admins"
    description  = "Permissions for use with Security Admin role. Use of setting IAM on most Resources.\nOrganizational, Folder  and Project IAM Admin roles.\nSCC PowerUser.\n"
    owner        = ["{svc_iac_account}@{infra_project_name}.iam.gserviceaccount.com"]
  }

  "{gcp_security_viewers_name}" {
    lifecycle { ignore_changes = ["initial_group_config"] }
    display_name = "GCP-Security Viewers"
    description  = "All Viewer Permissions for use with Security Auitor role.\nSCC User.\n"
    owner        = ["{svc_iac_account}@{infra_project_name}.iam.gserviceaccount.com"]
  }

  "{gcp_billing_admins_name}" {
    lifecycle { ignore_changes = ["initial_group_config"] }
    display_name = "GCP-Billing Admins"
    description  = "All Billing and Procurement roles.\n"
    owner        = ["{svc_iac_account}@{infra_project_name}.iam.gserviceaccount.com"]
  }
}

google_organization_iam_member {
  "domain:{customer_domain}" = [
    "roles/resourcemanager.organizationViewer",
  ]

  "group:{gcp_organization_admins_name}@{customer_domain}" = [
    "roles/resourcemanager.organizationAdmin",
    "roles/iam.organizationRoleAdmin",
    "roles/orgpolicy.policyAdmin",
    "roles/resourcemanager.folderAdmin",
    "roles/resourcemanager.folderIamAdmin",
    "roles/resourcemanager.projectCreator",
    "roles/resourcemanager.projectIamAdmin",
    "roles/cloudsupport.admin",
    "roles/billing.user",
  ]

  "group:{gcp_project_admins_name}@{customer_domain}" = [
    "roles/resourcemanager.folderViewer",
    "roles/resourcemanager.projectIamAdmin",
    "roles/resourcemanager.tagAdmin",
    "roles/iam.organizationRoleViewer",
    "roles/iam.serviceAccountCreator",
    "roles/owner",
    "roles/bigquery.admin",
    "roles/pubsub.admin",
    "roles/cloudsupport.admin",
    "roles/compute.networkAdmin",
    "roles/compute.viewer",
    "roles/compute.xpnAdmin",
    "roles/container.viewer",
    "roles/monitoring.admin",
    "roles/logging.admin",
    "roles/logging.configWriter",
    "roles/logging.privateLogViewer",
    "roles/monitoring.viewer",
    "roles/billing.user",
  ]

  "group:{gcp_security_admins_name}@{customer_domain}" = [
    "roles/orgpolicy.policyAdmin",
    "roles/compute.viewer",
    "roles/container.viewer",
    "roles/iam.organizationRoleViewer",
    "roles/iam.securityReviewer",
    // report-compliance reads witnesses through Cloud Asset Inventory;
    // securityReviewer does NOT carry cloudasset.assets.searchAllResources.
    "roles/cloudasset.viewer",
    "roles/monitoring.admin",
    "roles/logging.configWriter",
    "roles/logging.privateLogViewer",
    "roles/resourcemanager.folderIamAdmin",
    "roles/securitycenter.admin",
    "roles/billing.user",
  ]

  "group:{gcp_security_viewers_name}@{customer_domain}" = [
    "roles/viewer",
    "roles/resourcemanager.organizationViewer",
    "roles/compute.viewer",
    "roles/logging.configWriter",
    "roles/logging.privateLogViewer",
    "roles/monitoring.viewer",
    "roles/logging.viewer",
    "roles/container.viewer",
    "roles/iam.organizationRoleViewer",
    "roles/iam.securityReviewer",
    "roles/cloudasset.viewer",
  ]

  "group:{gcp_billing_admins_name}@{customer_domain}" = [
    "roles/resourcemanager.organizationViewer",
    "roles/billing.admin",
    "roles/billing.creator",
  ]
}
