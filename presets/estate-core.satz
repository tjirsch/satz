// The questions every estate has to answer on day 0, with the params they answer.
//
//   use "presets/estate-core.satz"
//
// `satz init` writes these params — from its flags where it has one, from
// its defaults otherwise; an INTERVIEW asks for
// them one at a time, from the questions in this pack. Every param below but one has a
// question, and every question says what changing the answer later costs, so a
// default is offered where one exists and a value is required where none is
// possible.
//
// Two kinds of param, and the interview treats them differently. Seven have NO
// POSSIBLE DEFAULT — the directory customer id, the organisation id, the domain,
// the short name, the display name, the first admin, the billing account: the
// pack cannot know the answer, so these block until a value is typed. The rest have a DERIVED OR CONVENTIONAL default — project and bucket
// names built from the short name, the folder name, the service account names,
// the region — and accepting one is an answer, recorded by writing it. A derived
// default is offered only once what it derives from is answered.
//
// Which packs make up the estate — the security-group model included — is the
// next pack, estate-map.satz: this one is the day-0 params and nothing else.
//
// This pack declares no resource. It publishes the day-0 answers every team beside
// the estate needs as the estate's core exports — outputs of every module under
// hcl/interfaces/, the modules the teams' own HCL reads them from — so an estate has
// them without writing an `export` of its own. Apart from those outputs, an estate that uses it and answers
// everything compiles to exactly what `satz init` would have written.
//
// The one param without a question is `workload_root_folder_name`: the folder directly
// under the organisation where the customer's and the teams' folders live. Empty — the
// default — is the organisation itself, and nothing is created for it; an empty answer is
// a real answer here, which a question could not record. Its export, `workload_root`, is
// not here either: it is the organisation, a static value, or a folder the estate
// declares, whose number is looked up, so the estate carries that section — `satz init`
// writes it from `--workload-root-folder-name`, or the operator by hand.

pack estate_core version "2.3"

params {
  // ---- no possible default: the pack cannot know these --------------------
  customer_id              = ""
  customer_organization_id = ""
  customer_domain          = ""
  customer_shortname       = ""
  first_admin              = ""
  billing_account_infra    = ""
  customer_longname        = ""

  // ---- derived from the answers above -------------------------------------
  infra_folder_name   = "Infrastructure"
  infra_project_name  = "{customer_shortname}-infra-001"
  infra_bucket_name   = "{customer_shortname}-infra-001-state"
  svc_iac_account     = "svc-iac-001"
  svc_iac_users_group = "svc-iac-users"
  deployment_engine   = "tofu"
  deployment_mode     = "local"
  default_region      = "europe-west3"
  default_zone        = "{default_region}-a"

  // ---- where the customer's and the teams' folders live: "" is the organisation
  workload_root_folder_name = ""

  // ---- what the customer answers to, which no pack can know -----------------
  compliance_frameworks = ["cis-gcp-5.0"]
}

question customer_id {
  prompt   = "The Google Workspace / Cloud Identity directory customer id (C0…)"
  why      = "Every group in the estate is created under this customer. There is no changing it afterwards; a different id is a different estate."
  reversal = recreate
  blast    = high
}

question customer_organization_id {
  prompt   = "The organisation id (the number, not the domain)"
  why      = "Every org policy, org grant and sink is scoped to it. A different organisation is a different estate."
  reversal = recreate
  blast    = high
}

question customer_domain {
  prompt   = "The customer's primary domain"
  why      = "Group addresses and the first admin are composed from it, and the Essential Contacts constraint allows it. Changing it renames every group."
  reversal = recreate
  blast    = high
}

question customer_shortname {
  prompt   = "A short name for this customer — lowercase, no spaces"
  why      = "Project ids, the state bucket and group prefixes derive from it, and those ids are globally unique and immutable once created."
  reversal = recreate
  blast    = high
}

question customer_longname {
  prompt   = "The customer's display name, as it should appear in descriptions"
  reversal = edit
  blast    = none
}

question first_admin {
  prompt   = "The first admin's account, local part only (the domain is added)"
  why      = "This is the human satz bootstraps as, and the first member of the IaC users group — the one account that can act before any service account exists."
  reversal = edit
  blast    = low
}

question billing_account_infra {
  prompt   = "The billing account for the infrastructure project (XXXXXX-XXXXXX-XXXXXX)"
  why      = "Relinking a project's billing is an update, but a project with no valid billing account cannot enable a single API — the bootstrap stops there."
  reversal = state_surgery
  blast    = low
}

question infra_folder_name {
  prompt    = "Display name of the folder that holds the infrastructure project"
  reversal  = edit
  blast     = none
  recommend = "Infrastructure"
}

question infra_project_name {
  prompt   = "The infrastructure project id"
  why      = "A project id is immutable. Changing it creates a second project and abandons the first, with the state bucket inside it."
  reversal = recreate
  blast    = high
}

question infra_bucket_name {
  prompt   = "The state bucket name (globally unique)"
  why      = "The bucket holds the Terraform state for the whole estate. Renaming it means migrating state by hand and re-initialising every checkout."
  reversal = recreate
  blast    = high
}

question svc_iac_account {
  prompt   = "Account id of the IaC service account (the part before @)"
  why      = "Everything after init runs as this account and every provider block impersonates it. A different name is a new account, new grants, and a re-initialised backend."
  reversal = recreate
  blast    = high
}

question svc_iac_users_group {
  prompt   = "The group whose members may impersonate the IaC service account"
  why      = "Membership of this group is what lets a human operate the estate. Renaming it moves every member."
  reversal = recreate
  blast    = low
}

question deployment_engine {
  prompt    = "Which tool applies the emitted HCL: tofu or terraform"
  reversal  = edit
  blast     = none
  recommend = "tofu"
}

question deployment_mode {
  prompt    = "Where the state lives: local while bootstrapping, cloud once the bucket exists"
  why       = "`satz migrate --mode cloud` moves it and re-initialises the backend; starting in cloud mode needs a bucket that does not exist yet."
  reversal  = state_surgery
  blast     = low
  recommend = "local"
}

question default_region {
  prompt    = "The default region for regional resources"
  why       = "Regional resources — the alerting bucket, sinks with a location — cannot move regions; a change recreates them."
  reversal  = recreate
  blast     = high
  recommend = "europe-west3"
}

question default_zone {
  prompt   = "The default zone, inside that region"
  reversal = edit
  blast    = low
}

question compliance_frameworks {
  prompt    = "Which compliance frameworks is this customer held to, as catalog ids: cis-gcp-4.0, cis-gcp-5.0, iso27001-2022"
  why       = "This is what the customer answers to — a contract, an auditor, a regulator — and it is not the same as what the packs in this estate claim. `satz report-compliance <estate>` writes one report section per framework named here, `satz prowler` scans for them, and an audit pack reads them. cis-gcp-4.0 and cis-gcp-5.0 are the two versions of the CIS Google Cloud Foundation Benchmark; 5.0 is the current one and the answer unless a signed contract names 4.0. iso27001-2022 is ISO/IEC 27001:2022, covered as a cross-walk: the packs keep claiming CIS, every technically evidenced Annex A control reads its verdict through the CIS controls that stand as its evidence, and the controls that are a human duty carry that duty and never read as satisfied by configuration alone. Naming a framework here does not switch a pack on; it decides what the reports are written against. A value that names no catalog is refused."
  reversal  = edit
  blast     = none
  recommend = ["cis-gcp-5.0"]
}

// ---- the core exports: what every team beside the estate reads ----------------

export "organization_id"     = customer_organization_id description "The organisation id"
export "customer_domain"     = customer_domain description "The customer's primary domain"
export "customer_shortname"  = customer_shortname description "The short name project ids, bucket names and group prefixes derive from"
export "default_region"      = default_region description "The default region for regional resources"
export "infra_project_id"    = infra_project_name description "The infrastructure project, which holds the state bucket"
export "iac_service_account" = "{svc_iac_account}@{infra_project_name}.iam.gserviceaccount.com" description "The service account the estate is applied as"
