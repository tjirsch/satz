// Delegated access, the base: one identity per delegation. A delegation gives a team — or a
// product, a service — access to a part of the organization's resources from an estate of
// its own, beside this one. This pack is the half every delegation has, whatever is
// delegated: an infrastructure project with the service account the team's pipelines run
// as and the bucket its states live in, the estate account user group whose members may act
// as that account, and that group's right to act as it. WHAT is delegated — the resources a
// workload needs and the estate account's roles on them — is another pack's: folders
// (`presets/delegated-folders.satz`), Google projects (`presets/delegated-projects.satz`),
// each entry of which names the delegation whose account works in it.
//
//   use "presets/delegation.satz" when use_delegation
//
// ONE LIST. One entry of `delegations` is one identity:
//   { name = "shop" estate_account_user_group = "gcp-shop-admins@example.com" }
// bound in the estate, added with `satz add-entry`, or requested by the team as
// `contributes_delegations` in a small pack of its own, checked with `satz check-request`
// and vendored by pull request. A `name` is lowercase letters, digits and `-`, starting
// with a letter.
//
// PER DELEGATION. The infrastructure project `{customer_shortname}-deploy-<name>` in the
// infrastructure folder, `google_folder.infra_folder`, beside the organization's own,
// billed to the infrastructure billing account, with the APIs
// of the entry's `apis`: the team's calls are billed to this project, so an API its
// resources' calls need is asked for here. Inside it the account `svc-deploy-<name>` and
// the state bucket `{customer_shortname}-deploy-<name>-state`, which the account may
// write; the estate account user group reads the project and may act as the account —
// that account only. On
// the billing account the account holds the entry's `billing_roles` (`roles/billing.user`
// unless the entry says more), on the organization `delegation_organization_roles` —
// `roles/browser` and nothing else by default: an interface looks a folder up by its name
// among its parent's folders, and that listing needs `resourcemanager.folders.list` on the
// parent.
//
// THE ESTATE ACCOUNT USER GROUP. The group of the entry's `estate_account_user_group`
// address is created, empty, in the customer's directory, labelled `deploy_<name>_users`.
// Who is a member is decided in the directory: someone with directory rights adds the
// workload team's people to it. Creating a group needs the Groups Admin role in the Google
// admin console for the organization's estate account (`satz update-prerequisites` names
// it); an estate on the customer's own groups assigns it once. A group that exists already
// is taken over once, before the first apply that creates it:
//   satz adopt <estate> --only google_cloud_identity_group --execute --import
// which imports the group into the organization's state; its members stay as they are.
//
// AN ENTRY THAT ASKS FOR MORE. `apis` and `billing_roles` are lists, and an entry that
// states one states it whole: the six APIs below plus its own, `roles/billing.user` plus
// its own.
//
// WHAT THE WORKLOAD ESTATE READS. The interface `delegation-<name>`, taken to its
// `interfaces/incoming/` folder: `infrastructure_project_id` (its infrastructure project),
// `estate_account` and its account id `estate_account_id`, `state_bucket`,
// `estate_account_user_group`, and what was delegated to the account beside its targets —
// `delegated_billing_roles`, `delegated_apis` — which tell the workload's team what the
// account holds; satz checks no role in a workload estate. `satz init --from` writes the workload estate from it, reading its estate
// account (`svc_iac_account`, `infra_project_name`) and its state bucket by the folder's
// name. Each target's own interface is taken beside it.
//
// NO CLAIM. A delegation is an identity, not a control: this pack witnesses nothing.

pack delegation version "2.3"

params {
  // One entry per delegation, `{ name estate_account_user_group apis billing_roles }`:
  // the name, the group that may act as the account, the APIs of its infrastructure
  // project and its roles on the billing account (the defaults of the `entries` statement
  // below when left out).
  delegations = []
  // What an account holds on the organization: the read a folder lookup needs.
  delegation_organization_roles = [
    "roles/browser",
  ]
  // What a delegation's estate account user group holds on the account: acting as it, and
  // nothing else.
  delegation_group_roles = [
    "roles/iam.serviceAccountTokenCreator",
    "roles/iam.serviceAccountUser",
  ]
}

// ---- what a team may ask for ----------------------------------------------------------

entries delegations {
  key      = "name"
  fields   = ["name", "estate_account_user_group", "apis", "billing_roles"]
  patterns = { name = "[a-z][a-z0-9-]*" estate_account_user_group = "[^@: ]+@[^@: ]+" }
  defaults = {
    apis = [
      "cloudbilling.googleapis.com",
      "cloudresourcemanager.googleapis.com",
      "iam.googleapis.com",
      "iamcredentials.googleapis.com",
      "serviceusage.googleapis.com",
      "storage.googleapis.com",
    ]
    billing_roles = ["roles/billing.user"]
  }
  description = "A delegation: its name, the address of the group that may act as its account, which the delegation creates, the APIs of its infrastructure project and its roles on the billing account"
}

// ---- per delegation: its estate account user group ----------------------------------------

// The group whose members may act as the delegation's estate account. The organization's
// estate account creates it, empty, and is no member of it.
google_cloud_identity_group {
  each delegations by name as "deploy_{each.name}_users" {
    email        = each.estate_account_user_group
    display_name = "Estate account user group of the delegation {each.name}"
    description  = "Its members may act as svc-deploy-{each.name}, the estate account of the delegation {each.name}, and read its infrastructure project. Members are added in the directory."
  }
}

// ---- per delegation: its infrastructure project, account and state bucket ---------------

// The project is labelled `deploy_<name>`, so a delegated project may carry the
// delegation's own name.
google_project {
  each delegations by name as "deploy_{each.name}" {
    name            = "deploy-{each.name}"
    project_id      = "{customer_shortname}-deploy-{each.name}"
    folder_id       = "google_folder.infra_folder.name"
    billing_account = billing_account_infra
    project_service = each.apis
    google_service_account {
      "deploy_{each.name}" {
        account_id   = "svc-deploy-{each.name}"
        display_name = "Account of the delegation {each.name}"
      }
    }
    google_storage_bucket {
      "deploy_{each.name}_state" {
        name                        = "{customer_shortname}-deploy-{each.name}-state"
        location                    = default_region
        force_destroy               = true
        public_access_prevention    = "enforced"
        uniform_bucket_level_access = true
        versioning { enabled = true }
      }
    }
    // The estate account user group reads its project; the account writes its states.
    // The account also uses the project's services: a workload estate bills every call
    // to its infrastructure project (`billing_project`, `user_project_override`), and
    // Google checks `serviceusage.services.use` there before any call into the workload's
    // own projects.
    google_project_iam_member {
      "group:{each.estate_account_user_group}" = [
        "roles/viewer",
      ]
      "serviceAccount:svc-deploy-{each.name}@{customer_shortname}-deploy-{each.name}.iam.gserviceaccount.com" = [
        "roles/serviceusage.serviceUsageConsumer",
      ]
    }
    google_storage_bucket_iam_member {
      bucket = "{customer_shortname}-deploy-{each.name}-state"
      "serviceAccount:svc-deploy-{each.name}@{customer_shortname}-deploy-{each.name}.iam.gserviceaccount.com" = [
        "roles/storage.objectAdmin",
      ]
    }
    // The estate account user group may act as its account — that account only.
    google_service_account_iam_member {
      service_account_id                       = "${{google_service_account.deploy_{each.name}.name}}"
      "group:{each.estate_account_user_group}" = delegation_group_roles
    }
  }
}

google_billing_account_iam_member {
  billing_account_id = billing_account_infra
  each delegations by name {
    "serviceAccount:svc-deploy-{each.name}@{customer_shortname}-deploy-{each.name}.iam.gserviceaccount.com" = each.billing_roles
  }
}

google_organization_iam_member {
  each delegations by name {
    "serviceAccount:svc-deploy-{each.name}@{customer_shortname}-deploy-{each.name}.iam.gserviceaccount.com" = delegation_organization_roles
  }
}

// ---- what the workload estate reads -------------------------------------------------------

each delegations by name {
  interface "delegation-{each.name}" {
    export "infrastructure_project_id" = "{customer_shortname}-deploy-{each.name}" description "The delegation's infrastructure project: the team's plans are billed to it"
    export "estate_account"            = "svc-deploy-{each.name}@{customer_shortname}-deploy-{each.name}.iam.gserviceaccount.com" description "The service account the workload estates run as"
    export "estate_account_id"         = "svc-deploy-{each.name}" description "The estate account's id, the part of its address before the `@`: a workload estate's `svc_iac_account`"
    export "state_bucket"              = "{customer_shortname}-deploy-{each.name}-state" description "The bucket the workload estates keep their states in"
    export "estate_account_user_group" = "{each.estate_account_user_group}" description "The group whose members may act as the account"
    export "account_group_roles"       = delegation_group_roles description "What that group holds on the account"
    export "billing_account"           = billing_account_infra description "The billing account a new project is linked to, and a budget is created on"
    export "delegated_billing_roles"   = each.billing_roles description "The roles the account holds on the billing account"
    export "delegated_apis"            = each.apis description "The APIs enabled on the delegation's infrastructure project"
  }
}
