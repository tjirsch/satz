// CIS 4.0 §1.14 / 5.0 §1.15 — API keys restricted to the APIs an application needs.
//
//   use "presets/cis-extensions/api-key-services.satz" when cis_api_key_services
//
// Opt-in because an API key that today calls anything stops working the moment
// this is enforced, unless its API targets are already narrowed. Set the
// allowed services first, then enforce.
//
// The constraint is a MANAGED one carrying a parameter, not a bare boolean —
// verified against a live organisation's OrgPolicy `ListConstraints`. It blocks
// creating an API key bound to a service account unless the key's API targets
// are non-empty and limited to `allowed_api_key_services`, which is exactly
// what the control asks for.

pack cis_extensions.api_key_services version "1.0"

params {
  // The services an API key may target. Empty means no service-account API key
  // may be created at all — the strictest reading, and a legitimate one.
  allowed_api_key_services = []
}

google_org_policy_policy {
  "iam-managed-disableServiceAccountApiKeyCreation" {
    name = "iam.managed.disableServiceAccountApiKeyCreation"
    parent = "organizations/{customer_organization_id}"
    spec {
      rules = [
        {
          enforce = "TRUE"
          parameters = {
            allowedServices = allowed_api_key_services
          }
        },
      ]
    }
  }
}

claim "cis-gcp" "4.0" "1.14" implements {
  resources = [
    "google_org_policy_policy.iam_managed_disableServiceAccountApiKeyCreation",
  ]
  interpretation = "A service-account API key may only be created when its API targets are non-empty and limited to the allowed services, so no key exists that can call every enabled API."
  duty_review_services = "The allowed-service list is the control: re-read it when an application starts calling a new API, rather than switching the constraint off."
}
claim "cis-gcp" "5.0" "1.15" implements {
  resources = [
    "google_org_policy_policy.iam_managed_disableServiceAccountApiKeyCreation",
  ]
  interpretation = "As for 4.0 §1.14 — 5.0 §1.15 (5.0 renumbered §1.13–1.16; its 1.13 is a different control, 'API keys only exist for active services')."
  duty_review_services = "The allowed-service list is the control: re-read it when an application starts calling a new API, rather than switching the constraint off."
}
