}
claim "cis-gcp" "5.0" "4.9" implements {
  resources = ["google_org_policy_policy.compute_managed_vmExternalIpAccess"]
  interpretation = "As for 4.0 §4.9 (5.0 §4.9, unchanged)."
}

claim "cis-gcp" "4.0" "5.1" implements {
  resources = ["google_org_policy_policy.storage_publicAccessPrevention"]
  interpretation = "Public access prevention is enforced, so buckets cannot be exposed to allUsers or allAuthenticatedUsers."
}
claim "cis-gcp" "5.0" "5.1" implements {
  resources = ["google_org_policy_policy.storage_publicAccessPrevention"]
  interpretation = "As for 4.0 §5.1 (5.0 §5.1, unchanged)."
