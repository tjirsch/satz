// 
// https://docs.cloud.google.com/resource-manager/docs/organization-policy/org-policy-constraints
// 
// Include all CIS GCP Foundation 4.0 policies
// https://www.cisecurity.org/cis-gcp-foundation-4-0-policies/
// 
// Some policies need to be activated manually before import
// 

// Converted by `satz import (from the YAML dialect)` — interior comments were not carried.

pack CIS_GCP_Foundation_4_0 version "2.5"

params {
  // ---- coverage beyond the baseline: OPT-IN, because each of these can break
  // a workload that was legitimate the day before. Turn one on and `use` its
  // fragment from presets/cis-extensions/ — see presets/README.md. Constraint
  // names and shapes were verified against a live organisation's OrgPolicy
  // ListConstraints, not transcribed from documentation.
  cis_block_project_ssh_keys = false
  cis_require_shielded_vm    = false
  cis_confidential_computing = false
  cis_cloud_sql_hardening    = false
  cis_cmek_required          = false
  cis_api_key_services       = false
  cis_bucket_retention       = false

  // CIS §1.1 Domain Restricted Sharing (iam.managed.allowedPolicyMembers):
  // PRINCIPAL SETS whose members may be granted IAM roles. Default = the
  // customer's own org. Add a partner's org here when the estate genuinely
  // needs cross-org grants.
  //
  // v2.0 dropped the legacy `iam.allowedPolicyMemberDomains` and its
  // `allowed_policy_member_customers` param; since v2.5 the pack goes further
  // and declares that constraint OFF (`reset = true`, in the superseded
  // section below), because not declaring it leaves a policy already set on the
  // organisation enforcing beside this one. The claim's
  // duty_legacy_superseded says why running both is the defect.
  allowed_policy_member_principal_sets = [
    "//cloudresourcemanager.googleapis.com/organizations/{customer_organization_id}",
  ]
  // Individual principals allowed despite the locks. Only the MANAGED
  // constraint can express this — the legacy `iam.allowedPolicyMemberDomains`
  // takes directory customer ids and, per Google, "cannot configure exceptions
  // for specific principals"; its documented remedy for granting a service
  // agent is disable / grant / re-enable — which is exactly why this pack runs
  // the managed constraint ALONE and declares the legacy one off. Where an
  // estate has not yet applied that (pack < 2.5, legacy policy still enforcing),
  // this list does NOT by itself unblock a service agent.
  //
  // Default = Security Command Center's service agents. They are CANONICAL:
  // the address is derived from the org id inside a Google-owned domain nobody
  // else can register, so nobody can plant an identity that matches, and
  // allowing them costs nothing. SCC activation grants roles to them, and
  // domain-restricted sharing blocks exactly that.
  //
  // NOTE: overriding this param REPLACES the list — Satz v0 has no list
  // concatenation — so keep these five entries when adding your own.
  // SCC's org-level service agents, READ OFF estate 1's live org IAM policy — not
  // inferred from the docs, which name two of them and misspell one. All follow
  // the canonical `service-org-<ORG_ID>@<service>` shape: derived from the org
  // id, in a Google-owned domain nobody else can register.
  //
  // These agents live in Google tenant projects, NOT in the customer's org, so
  // the org principal set does not cover them — they have to be named.
  //
  // MEASURED 2026-09-04 on a second organization, with every SCC service the SDK
  // can set turned on: the org IAM policy carried exactly these five and no
  // sixth. They come with SCC activation, not one per service — the earlier
  // caution here, that each further service provisions another agent, was wrong.
  // A notification config does add a `gcp-sa-scc-notification` agent, but on the
  // Pub/Sub TOPIC rather than at the organization, and it was granted with this
  // constraint enforced and that agent not listed. Still unproven: Security
  // Health Analytics (a failed precondition on that org) and the AWS/Azure
  // connectors. If an activation ever stalls, the org IAM policy is still where
  // the answer is.
  allowed_policy_member_subjects = [
    "serviceAccount:service-org-{customer_organization_id}@security-center-api.iam.gserviceaccount.com",
    "serviceAccount:service-org-{customer_organization_id}@gcp-sa-csc-hpsa.iam.gserviceaccount.com",
    "serviceAccount:service-org-{customer_organization_id}@gcp-sa-dspm-hpsa.iam.gserviceaccount.com",
    "serviceAccount:service-org-{customer_organization_id}@gcp-sa-ee-hpsa.iam.gserviceaccount.com",
    "serviceAccount:service-org-{customer_organization_id}@gcp-sa-ktd-hpsa.iam.gserviceaccount.com",
  ]
  // compute.managed.restrictProtocolForwardingCreationForTypes: the load
  // balancing schemes for which protocol forwarding may be created. Default =
  // INTERNAL only, which is what the legacy list constraint enforced before
  // v2.5. A managed constraint is configured through `parameters`, so this is a
  // param rather than a values list.
  allowed_protocol_forwarding_schemes = [
    "INTERNAL",
  ]
  // essentialcontacts.managed.allowedContactDomains: the DOMAINS whose
  // addresses may be set as essential contacts (each entry `@domain`).
  // Default = the customer's own domain. Some customers keep contacts on a
  // different domain, or on several — a LIST param since v2.2, so neither
  // case forks the pack.
  essential_contacts_allowed_domains = [
    "@{customer_domain}",
  ]
}

// CIS 4.5 — interactive serial console access is off org-wide. Safe enough for
// the baseline: nothing routine reaches a VM this way, and the exemption path
// is a tag condition rather than switching the constraint off.
"compute-managed-disableSerialPortAccess" {
  name = "compute.managed.disableSerialPortAccess"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"iam-managed-disableServiceAccountKeyCreation" {
  name = "iam.managed.disableServiceAccountKeyCreation"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"iam-managed-disableServiceAccountKeyUpload" {
  name = "iam.managed.disableServiceAccountKeyUpload"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"iam-managed-preventPrivilegedBasicRolesForDefaultServiceAccounts" {
  name = "iam.managed.preventPrivilegedBasicRolesForDefaultServiceAccounts"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"iam-automaticIamGrantsForDefaultServiceAccounts" {
  name = "iam.automaticIamGrantsForDefaultServiceAccounts"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"storage-uniformBucketLevelAccess" {
  name = "storage.uniformBucketLevelAccess"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"compute-setNewProjectDefaultToZonalDNSOnly" {
  name = "compute.setNewProjectDefaultToZonalDNSOnly"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

// CIS protocol forwarding, MANAGED form. Google replaces the legacy list
// constraint with this one; the legacy twin is switched off in the same breath
// (see the superseded section below) so the two never both apply. Same effect:
// only INTERNAL protocol forwarding may be created. A managed constraint is
// configured through `parameters` — the legacy form's `allowed_values` has no
// meaning here.
"compute-managed-restrictProtocolForwardingCreationForTypes" {
  name = "compute.managed.restrictProtocolForwardingCreationForTypes"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
        parameters = {
          allowedSchemes = allowed_protocol_forwarding_schemes
        }
      },
    ]
  }
}

"compute-skipDefaultNetworkCreation" {
  name = "compute.skipDefaultNetworkCreation"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"gcp-resourceLocations" {
  name = "gcp.resourceLocations"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        values {
          allowed_values = [
            "in:eu-locations",
            "in:us-locations",
          ]
        }
      },
    ]
  }
}

"compute-managed-requireOsLogin" {
  name = "compute.managed.requireOsLogin"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"gcp-detailedAuditLoggingMode" {
  name = "gcp.detailedAuditLoggingMode"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"iam-disableAuditLoggingExemption" {
  name = "iam.disableAuditLoggingExemption"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"compute-requireVpcFlowLogs" {
  name = "compute.requireVpcFlowLogs"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        values {
          allowed_values = [
            "ESSENTIAL",
            "LIGHT",
            "COMPREHENSIVE",
          ]
        }
      },
    ]
  }
}

"storage-publicAccessPrevention" {
  name = "storage.publicAccessPrevention"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"compute-managed-vmCanIpForward" {
  name = "compute.managed.vmCanIpForward"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"compute-managed-vmExternalIpAccess" {
  name = "compute.managed.vmExternalIpAccess"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
      },
    ]
  }
}

"essentialcontacts-managed-allowedContactDomains" {
  name = "essentialcontacts.managed.allowedContactDomains"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
        parameters = {
          allowedDomains = essential_contacts_allowed_domains
        }
      },
    ]
  }
}

"iam-managed-allowedPolicyMembers" {
  name = "iam.managed.allowedPolicyMembers"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [
      {
        enforce = "TRUE"
        parameters = {
          allowedPrincipalSets = allowed_policy_member_principal_sets
          allowedMemberSubjects = allowed_policy_member_subjects
        }
      },
    ]
  }
}

// ---------------------------------------------------------------------------
// Control claims. Each org policy below is the enforcement mechanism for a CIS
// control; the claim names the emitted resource so `require` and
// `report-compliance` can find the witness. Control IDs verified against
// Google's inspec-gcp-cis-benchmark 4.0.0 profile; paraphrases are ours (CIS
// prose is licence-restricted).
// ---------------------------------------------------------------------------

// 5.0 introduced §1.1 "Organization resources". 1.1.4 asks whether the
// organization constrains its projects centrally at all — which is what this
// pack IS, so the witness is the whole baseline rather than any one policy.
// The five constraints the benchmark names as the baseline (resource
// locations, OS Login, external IPs, uniform bucket access, allowed member
// domains) are all in the list below.
// ---------------------------------------------------------------------------
// SUPERSEDED LEGACY CONSTRAINTS — declared OFF, on purpose.
//
// Where Google replaces a legacy constraint with a managed one, this pack runs
// the REPLACEMENT ALONE. Both forms in force is the defect, not a belt-and-
// braces win: org-policy constraints AND together, so every exemption would
// have to lift TWO policies — and for several of these Google's only documented
// exemption path is to disable the constraint org-wide, grant, and re-enable,
// which is a window with the control switched off.
//
// Absence is not enough. A legacy policy already set on an organisation is
// invisible to an apply that does not declare it: it keeps enforcing, and has
// to be deleted by hand, on every estate, forever. Declaring it with
// `reset = true` — restore the constraint's default, which is ALLOW for every
// constraint below, verified against a live organisation — lets the estate say
// it, the apply do it, and a later re-enabling revert on the next apply.
//
// On an organisation where one of these is already set, run
// `satz adopt --only google_org_policy_policy --execute --import` before the
// apply, so the existing policy is imported rather than created twice.
//
// A constraint is listed here ONLY when this pack enables its managed
// replacement; `cis-extensions/` carries its own, next to the fragment that
// enables them. Managed constraints with no legacy form — most of them, 45 of
// the 60 a live organisation offers — need nothing.
// ---------------------------------------------------------------------------

// Superseded by iam.managed.allowedPolicyMembers (CIS 1.1 / 5.0 1.2). Google
// declares no equivalence between these two names, so the pairing is ours; the
// reasoning is in the claim's duty_legacy_superseded.
"iam-allowedPolicyMemberDomains" {
  name = "iam.allowedPolicyMemberDomains"
  parent = "organizations/{customer_organization_id}"
  spec {
    reset = true
  }
}

// Superseded by compute.managed.requireOsLogin.
"compute-requireOsLogin" {
  name = "compute.requireOsLogin"
  parent = "organizations/{customer_organization_id}"
  spec {
    reset = true
  }
}

// Superseded by essentialcontacts.managed.allowedContactDomains.
"essentialcontacts-allowedContactDomains" {
  name = "essentialcontacts.allowedContactDomains"
  parent = "organizations/{customer_organization_id}"
  spec {
    reset = true
  }
}

// Superseded by iam.managed.disableServiceAccountKeyCreation.
"iam-disableServiceAccountKeyCreation" {
  name = "iam.disableServiceAccountKeyCreation"
  parent = "organizations/{customer_organization_id}"
  spec {
    reset = true
  }
}

// Superseded by iam.managed.disableServiceAccountKeyUpload.
"iam-disableServiceAccountKeyUpload" {
  name = "iam.disableServiceAccountKeyUpload"
  parent = "organizations/{customer_organization_id}"
  spec {
    reset = true
  }
}

// Superseded by compute.managed.restrictProtocolForwardingCreationForTypes as of
// v2.5. This block kept its address deliberately: an estate on v2.4 carries the
// legacy policy under exactly this name, so the switch is an in-place update
// rather than a destroy and a create of the same org policy in one apply.
"compute-restrictProtocolForwardingCreationForTypes" {
  name = "compute.restrictProtocolForwardingCreationForTypes"
  parent = "organizations/{customer_organization_id}"
  spec {
    reset = true
  }
}

claim "cis-gcp" "5.0" "1.1.4" implements {
  resources = [
    "google_org_policy_policy.compute_managed_requireOsLogin",
    "google_org_policy_policy.compute_managed_vmCanIpForward",
    "google_org_policy_policy.compute_managed_vmExternalIpAccess",
    "google_org_policy_policy.compute_requireVpcFlowLogs",
    "google_org_policy_policy.compute_managed_restrictProtocolForwardingCreationForTypes",
    "google_org_policy_policy.compute_setNewProjectDefaultToZonalDNSOnly",
    "google_org_policy_policy.compute_skipDefaultNetworkCreation",
    "google_org_policy_policy.essentialcontacts_managed_allowedContactDomains",
    "google_org_policy_policy.gcp_detailedAuditLoggingMode",
    "google_org_policy_policy.gcp_resourceLocations",
    "google_org_policy_policy.iam_automaticIamGrantsForDefaultServiceAccounts",
    "google_org_policy_policy.iam_disableAuditLoggingExemption",
    "google_org_policy_policy.iam_managed_allowedPolicyMembers",
    "google_org_policy_policy.iam_managed_disableServiceAccountKeyCreation",
    "google_org_policy_policy.iam_managed_disableServiceAccountKeyUpload",
    "google_org_policy_policy.iam_managed_preventPrivilegedBasicRolesForDefaultServiceAccounts",
    "google_org_policy_policy.storage_publicAccessPrevention",
    "google_org_policy_policy.storage_uniformBucketLevelAccess",
  ]
  interpretation = "The organization carries a centrally managed org-policy baseline: every constraint this pack emits applies at the organization node and is inherited by every folder and project beneath it."
  duty_review_baseline = "The baseline is a decision, not a default — re-read it when the organisation adds a workload class the current constraints were not chosen for."
}

claim "cis-gcp" "4.0" "1.1" implements {
  resources = [
    "google_org_policy_policy.iam_managed_allowedPolicyMembers",
  ]
  interpretation = "Domain Restricted Sharing, enforced by the MANAGED constraint alone: only the listed principal sets may be granted roles, plus the individually listed subjects. Consumer accounts cannot be granted roles. The legacy iam.allowedPolicyMemberDomains is deliberately declared OFF (reset = true) rather than merely left out, so a policy already set on the organisation cannot keep enforcing beside this one — see duty_legacy_superseded."
  duty_legacy_superseded = "The legacy iam.allowedPolicyMemberDomains is superseded, not forgotten. Google states it cannot configure exceptions for specific principals, so its only remedy for granting a Google service agent is to DISABLE the constraint, grant, and re-enable. Running it therefore does not add protection — it converts every service activation into a window where domain-restricted sharing is switched off org-wide. The managed constraint enforces the same control continuously while naming its exceptions explicitly, which is why this baseline runs the managed constraint alone and, since v2.5, declares the legacy one reset instead of simply omitting it: an omitted constraint that is already set on the organisation goes on enforcing, unseen by the apply."
  duty_review_allowlist = "Re-check allowed_policy_member_principal_sets / _subjects whenever a partner directory is added or a Google-managed service agent needs a grant."
}
claim "cis-gcp" "5.0" "1.2" implements {
  resources = [
    "google_org_policy_policy.iam_managed_allowedPolicyMembers",
  ]
  interpretation = "As for 4.0 §1.1 — 5.0 §1.2 (5.0 inserted a new §1.1 'Organization resources' subsection, shifting the former 1.x up by one)."
  duty_legacy_superseded = "The legacy iam.allowedPolicyMemberDomains is superseded, not forgotten — see the 4.0 claim for why running it would weaken rather than strengthen the control."
  duty_review_allowlist = "Re-check allowed_policy_member_principal_sets / _subjects whenever a partner directory is added or a Google-managed service agent needs a grant."
}

claim "cis-gcp" "4.0" "1.4" implements {
  resources = [
    "google_org_policy_policy.iam_managed_disableServiceAccountKeyCreation",
    "google_org_policy_policy.iam_managed_disableServiceAccountKeyUpload",
  ]
  interpretation = "User-managed service account keys can neither be created nor uploaded org-wide, leaving only Google-managed keys."
}
claim "cis-gcp" "5.0" "1.5" implements {
  resources = [
    "google_org_policy_policy.iam_managed_disableServiceAccountKeyCreation",
    "google_org_policy_policy.iam_managed_disableServiceAccountKeyUpload",
  ]
  interpretation = "As for 4.0 §1.4 — 5.0 §1.5."
}

claim "cis-gcp" "4.0" "1.5" implements {
  resources = [
    "google_org_policy_policy.iam_managed_preventPrivilegedBasicRolesForDefaultServiceAccounts",
  ]
  interpretation = "Default service accounts are prevented from holding privileged basic roles."
}
claim "cis-gcp" "5.0" "1.6" implements {
  resources = [
    "google_org_policy_policy.iam_managed_preventPrivilegedBasicRolesForDefaultServiceAccounts",
  ]
  interpretation = "As for 4.0 §1.5 — 5.0 §1.6."
}
claim "cis-gcp" "4.0" "1.5" contributes {
  resources = ["google_org_policy_policy.iam_automaticIamGrantsForDefaultServiceAccounts"]
  interpretation = "Also disables the automatic Editor grant to default service accounts at project creation."
}
claim "cis-gcp" "5.0" "1.6" contributes {
