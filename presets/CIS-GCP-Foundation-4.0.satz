  interpretation = "As for 4.0 §1.5 — 5.0 §1.6."
}

claim "cis-gcp" "4.0" "1.16" contributes {
  resources = ["google_org_policy_policy.essentialcontacts_managed_allowedContactDomains"]
  interpretation = "Restricts which domains may be set as Essential Contacts. The contact itself is declared by the essential-contacts-organization pack, which carries the implements claim."
}
claim "cis-gcp" "5.0" "1.17" contributes {
  resources = ["google_org_policy_policy.essentialcontacts_managed_allowedContactDomains"]
  interpretation = "As for 4.0 §1.16 — 5.0 §1.17."
}

claim "cis-gcp" "4.0" "2.1" contributes {
  resources = [
    "google_org_policy_policy.gcp_detailedAuditLoggingMode",
    "google_org_policy_policy.iam_disableAuditLoggingExemption",
  ]
  interpretation = "Detailed audit logging mode plus a ban on per-principal audit-logging exemptions keep the audit trail complete. The audit config itself is declared by the audit-logsink pack."
}
claim "cis-gcp" "5.0" "2.1" contributes {
  resources = [
    "google_org_policy_policy.gcp_detailedAuditLoggingMode",
    "google_org_policy_policy.iam_disableAuditLoggingExemption",
  ]
  interpretation = "As for 4.0 §2.1 (5.0 §2.1, unchanged)."
}

claim "cis-gcp" "4.0" "3.1" implements {
  resources = ["google_org_policy_policy.compute_skipDefaultNetworkCreation"]
  interpretation = "New projects are created without the auto-mode default VPC and its permissive firewall rules."
}
claim "cis-gcp" "5.0" "3.1" implements {
  resources = ["google_org_policy_policy.compute_skipDefaultNetworkCreation"]
  interpretation = "As for 4.0 §3.1 (5.0 §3.1, unchanged)."
}

claim "cis-gcp" "4.0" "3.8" implements {
  resources = ["google_org_policy_policy.compute_requireVpcFlowLogs"]
  interpretation = "Subnets must enable VPC Flow Logs."
}
claim "cis-gcp" "5.0" "3.10" implements {
  resources = ["google_org_policy_policy.compute_requireVpcFlowLogs"]
  interpretation = "As for 4.0 §3.8 — 5.0 §3.10 (5.0 inserted 3.8 VPC Service Controls and 3.9 Private Service Connect)."
}

claim "cis-gcp" "4.0" "4.5" implements {
  resources = ["google_org_policy_policy.compute_managed_disableSerialPortAccess"]
  interpretation = "The serial-port-enable metadata key cannot be set to true, so no VM exposes an interactive serial console."
}
claim "cis-gcp" "5.0" "4.5" implements {
  resources = ["google_org_policy_policy.compute_managed_disableSerialPortAccess"]
  interpretation = "As for 4.0 §4.5 (5.0 §4.5, unchanged)."
}

claim "cis-gcp" "4.0" "4.4" implements {
  resources = ["google_org_policy_policy.compute_managed_requireOsLogin"]
  interpretation = "OS Login is required, so VM SSH access is governed by IAM rather than metadata keys."
  duty_existing_vms = "Enforcing OS Login can cut existing SSH access patterns; verify before enabling on an org with running VMs."
}
claim "cis-gcp" "5.0" "4.4" implements {
  resources = ["google_org_policy_policy.compute_managed_requireOsLogin"]
  interpretation = "As for 4.0 §4.4 (5.0 §4.4, unchanged)."
  duty_existing_vms = "Enforcing OS Login can cut existing SSH access patterns; verify before enabling on an org with running VMs."
}

claim "cis-gcp" "4.0" "4.6" implements {
  resources = ["google_org_policy_policy.compute_managed_vmCanIpForward"]
  interpretation = "Instances may not enable IP forwarding."
  duty_appliances = "NAT gateways and network appliances legitimately need IP forwarding; grant an exception deliberately rather than relaxing the org policy."
}
claim "cis-gcp" "5.0" "4.6" implements {
  resources = ["google_org_policy_policy.compute_managed_vmCanIpForward"]
  interpretation = "As for 4.0 §4.6 (5.0 §4.6, unchanged)."
  duty_appliances = "NAT gateways and network appliances legitimately need IP forwarding; grant an exception deliberately rather than relaxing the org policy."
}

