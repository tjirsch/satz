claim "cis-gcp" "4.0" "5.2" implements {
  resources = ["google_org_policy_policy.storage_uniformBucketLevelAccess"]
  interpretation = "Uniform bucket-level access disables object ACLs; bucket access is governed by IAM alone."
}
claim "cis-gcp" "5.0" "5.2" implements {
  resources = ["google_org_policy_policy.storage_uniformBucketLevelAccess"]
  interpretation = "As for 4.0 §5.2 (5.0 §5.2, unchanged)."
