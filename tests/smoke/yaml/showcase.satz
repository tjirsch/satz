// The showcase estate — every language feature in one compilable file. The
// reference (docs/language.md) cites this file by section instead of
// carrying loose snippets; scripts/smoke.sh transpiles it in CI.
// Example values only (docs/examples.md).

/* A block comment spans lines. `#` and `//` comments run to the end of a line. */

estate showcase

// --- Params: the only thing an estate needs to say to fit a pristine pack. ---
params {
  customer_organization_id = "123456789012"
  customer_id              = "C0example"
  customer_domain          = "example.com"
  customer_shortname       = "corp"
  infra_project_name       = "corp-infra-001"
  billing_account_infra    = "012345-6789AB-CDEF01"
  default_region           = "europe-west3"
  audit_retention_days     = 400            # a number; interpolates like a string
  want_optional            = false          # a `use … when` switch, declared here
  pack_bucket_location     = "europe-west3" # overrides showcase-pack's "EU" default
  group_model_flat         = true           # exactly one of these two — see `question oneof` below
  group_model_split        = false
  pack_bucket_adopted      = true           # acknowledges showcase-pack's `notice` — the command has run
  team_folder_name         = ""             # an empty answer its question gives a meaning — see `empty` below
  // A project's parent, said rather than nested — see the `google_project` below.
  archive_project_folder   = "google_folder.infra.name"
  // A list param a PACK adds to: showcase-pack declares
  // `contributes_infra_project_services` and its entry lands here, after these two,
  // while that pack is used. A contribution is no param of its own — nothing binds it,
  // and it is no variable — so this list is still the estate's to say.
  infra_project_services = [
    "cloudresourcemanager.googleapis.com",
    "storage.googleapis.com",
  ]
  // A list of objects the `each` over `google_pubsub_topic` below writes one topic for,
  // labelled by `name`.
  event_topics = [
    { name = "orders" retention = "86400s" },
    { name = "billing" retention = "604800s" },
  ]
}
// ---------------------------------------------------------------------------
// QUESTIONS — what to ask a customer so a param can be filled, and what getting
// it wrong costs. Metadata: they emit nothing, and a question must be declared
// in the file that declares its param (a question gating a pack cannot live in
// the gated pack, because questions are absorbed after the `use … when` guard).
// ---------------------------------------------------------------------------

question customer_shortname {
  prompt   = "Short name identifying this customer"
  why      = "Project ids, bucket names and group prefixes derive from it, and those ids are globally unique — changing it later recreates them."
  reversal = recreate
  blast    = none
}

question default_region {
  prompt    = "Which region should regional resources default to?"
  why       = "Moving a bucket or a dataset later is a copy, not an edit."
  reversal  = state_surgery
  blast     = low
  recommend = "europe-west3"
}

// An exclusive choice: the options name existing boolean params, so an answer
// set stays a plain param map and a question never becomes a second way to set
// a value. `check_oneof` refuses two true branches by name — today the same
// mistake surfaces as an opaque fold conflict on whatever address they share.
question oneof group_model {
  prompt   = "Which security-group model does this customer run?"
  why      = "Splitting network authority out later means a new group, membership moves and re-granted roles."
  reversal = state_surgery
  blast    = low
  required = true
  option group_model_flat { label = "Flat — network authority sits with project admins" }
  option group_model_split { label = "Split — a separate network-admins group" why = "For customers with a distinct network team." }
}

// A question may say what an empty answer means. `""` is then an answer like any other:
// offered, accepted and counted. Without `empty`, "" is a value nobody has given yet.
question team_folder_name {
  prompt   = "Display name of a folder for the team"
  reversal = edit
  blast    = none
  empty    = "no team folder"
}

// A choice that is not `required` is also answered by none of its options — `none` in an
// interview, every option `false` in the file — so one option is enough to make it a choice.
question oneof optional_extras {
  prompt   = "Which optional extras does this estate take?"
  reversal = edit
  blast    = none
  option want_optional { label = "The optional pack — one more bucket" }
}

// --- Estate configuration blocks: emitted as providers.tf / the backend. -----
terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

providers {
  google {
    alias                 = "google"
    project               = infra_project_name
    region                = default_region
    user_project_override = true
    billing_project       = infra_project_name
  }
  "google-beta" {
    alias                 = "google-beta"
    project               = infra_project_name
    region                = default_region
    user_project_override = true
    billing_project       = infra_project_name
  }
}

// --- `use`, in its three positions. ------------------------------------------
// 1. top level: the pack's entries land where they are declared
use "showcase-pack.satz"
// 2. `as`: a bare-list pack becomes the CONTENT of a resource map
use "showcase-policies.satz" as google_org_policy_policy
// 3. `when`: pulled in only if the (declared) param is truthy — here it is not
use "showcase-optional.satz" when want_optional

// --- `suppress`: decline what a pack provides, without forking it. -----------
// The pack declares this policy; the estate does not want it. A suppression
// that stops matching (typo, upstream rename) is a hard error.
suppress google_org_policy_policy "compute-managed-vmExternalIpAccess"
// One role of one grant — the member keeps its other roles.
suppress google_organization_iam_member "group:gcp-auditors@{customer_domain}" role "roles/browser"

// --- A group, its member, and the adoption id of one that already exists. ---
google_cloud_identity_group {
  "gcp-auditors" {
    "import-id"  = "groups/01abcdef2ghijk3" // resolved by `satz adopt`, written back here
    display_name = "GCP Auditors"
    member = [
      "audit.lead@{customer_domain}",
    ]
  }
}

// --- IAM grants: member → roles; a role is a string or a conditional object. --
google_organization_iam_member {
  "group:gcp-auditors@{customer_domain}" = [
    "roles/browser", // suppressed above — never emitted
    "roles/iam.securityReviewer",
    {
      role = "roles/storage.objectViewer"
      condition {
        title      = "audit-objects-only"
        expression = "resource.name.startsWith(\"projects/_/buckets/{customer_shortname}-audit-logs\")"
      }
    },
  ]
}

// --- Hierarchy: folder → project → resources; scope attributes are derived. --
google_folder {
  infra {
    display_name = "Infrastructure"
    google_project {
      infra {
        name            = "corp-IaC"
        project_id      = infra_project_name
        billing_account = billing_account_infra
        project_service = infra_project_services
        google_storage_bucket {
          audit_logs {
            name                        = "{customer_shortname}-audit-logs"
            location                    = "EU"
            uniform_bucket_level_access = true
            // a repeated block is a LIST of objects — twice the same key is an error
            lifecycle_rule = [
              {
                action { type = "Delete" }
                condition { age = audit_retention_days }
              },
              {
                action { type = "Delete" }
                condition {
                  num_newer_versions = 100
                  with_state         = "ARCHIVED"
                }
              },
            ]
          }
        }
        // A bucket-scoped grant, as a labelled resource: one member, one role,
        // its scope written as an attribute like any other.
        google_storage_bucket_iam_member {
          auditors_read {
            bucket = "${{google_storage_bucket.audit_logs.name}}"
            role   = "roles/storage.objectViewer"
            member = "group:gcp-auditors@{customer_domain}"
          }
        }
        // …and the same grant as a MEMBER MAP. A type whose scope is neither the
        // organisation nor the folder/project it sits in writes that scope in
        // the map (`bucket = …`); every other key is a member. The scope
        // namespaces the grant, so a second map for a second bucket is a second
        // grant even with the same member and role.
        google_storage_bucket_iam_member {
          bucket = "{customer_shortname}-audit-logs-archive"
          "group:gcp-auditors@{customer_domain}" = [
            "roles/storage.objectViewer",
          ]
        }
        google_project_iam_member {
          "group:gcp-auditors@{customer_domain}" = [
            "roles/viewer",
          ]
        }
      }
    }
  }
}

// --- A project whose parent is SAID, not nested. `folder_id` takes a reference
//     to a folder the estate declares, or the id of one that already exists; an
//     empty value says nothing and the node the block stands in decides. A pack
//     carries its own parent this way, so it emits the same project wherever its
//     `use` line stands.
google_project {
  archive {
    name            = "corp-archive"
    project_id      = "{customer_shortname}-archive-001"
    folder_id       = archive_project_folder
    billing_account = billing_account_infra
  }
}

// --- `request`: what a project may add to a list, and each entry's shape — checked at
//     every compile, and by `satz check-request` on a project's file before it is used.
request event_topics {
  key         = "name"
  fields      = ["name", "retention"]
  description = "A Pub/Sub topic in the infrastructure project"
}

// --- `each`: one labelled body per entry of a list param, labelled by the entry's
//     `name`; `{each.x}` in a string and a bare `each.x` read the entry. The HCL is what
//     a hand-written `orders { … }` and `billing { … }` give.
google_pubsub_topic {
  each event_topics by name {
    name                       = "{customer_shortname}-{each.name}"
    project                    = infra_project_name
    message_retention_duration = each.retention
  }
}

// --- `export`: what the estate publishes to the projects beside it — estates with
//     their own repository, config, state and pipeline, written in HCL or in Satz.
//     Each one is an output of the root module and a value of the generated
//     interfaces under interfaces/. A param, a literal, or an attribute satz writes
//     is known now and is a literal; an attribute only the cloud knows is a lookup,
//     a `data` source the project's plan reads. An export outside every `interface`
//     block is a core export, in every interface.
export "customer_domain"      = customer_domain description "The customer's primary domain"
export "default_region"       = default_region description "The region the estate builds in"
export "infra_project_id"     = "${{google_project.infra.project_id}}" description "The infrastructure project"
export "infra_folder"         = "${{google_folder.infra.name}}" description "The infrastructure folder, folders/<number>"
export "workload_folder"      = "organizations/{customer_organization_id}" description "Where the customer's and the projects' folders live: the organisation"
export "infra_project_number" = "${{google_project.infra.number}}"
export "audit_bucket_url"     = "${{google_storage_bucket.audit_logs.url}}"
export "regions"              = [default_region, "europe-west4"]

// --- `all <type>`: every resource of one type the estate emits, as one map keyed by
//     the resource's label — a folder's `folders/<number>`, a bucket's name. `under`
//     keeps the ones placed under one folder or project. A resource marked private —
//     `private = true` in its body, or the statement below for a pack's — is left out.
export "folders"        = all google_folder description "Every folder, by label"
export "buckets"        = all google_storage_bucket
export "infra_projects" = all google_project under google_folder.infra description "The Google projects in the infrastructure folder"

// --- `private`: the pack's bucket stays out of every export, without forking the pack.
private google_storage_bucket.pack_bucket

// --- `interface`: what one project reads — interfaces/archive/, the folder the
//     project takes whole — beside the core exports above, which every interface
//     carries. The same interface in another file adds to it. `common` puts an
//     interface into the library every project's folder carries (a pack's
//     interface is common without the word). `use interface` brings another
//     interface's exports into the project's own. `attach [ … ]` makes an export an
//     attach point: the project may grant on its Google project with
//     `google_project_iam_member` in its own state.
interface "audit" common {
  export "audit_bucket_name" = "${{google_storage_bucket.audit_logs.name}}" description "The audit log bucket"
}

interface "archive" {
  use interface "audit"
  export "archive_project_id"     = "${{google_project.archive.project_id}}" attach ["google_project_iam_member"] description "The project's Google project"
  export "archive_project_number" = "${{google_project.archive.number}}"
}

// --- `hcl`: raw passthrough, verbatim, never interpolated, opaque to claims. --
hcl trust "reviewed 2026-08-30: static address until the provider gap closes" {
  resource "google_compute_address" "legacy_ip" {
    name   = "legacy-ip"
    region = "europe-west3"
  }
}

// --- `action`: a deployment step that has no provider resource. --------------
// The real case is SCC service enablement: the provider carries no binding for
// it, so it cannot be written as a resource in any language satz compiles.
// An action is inert until `satz run-actions` is invoked — nothing here runs at
// transpile time — and no claim can cover it. `reason` is mandatory, because it
// is what the warning quotes to whoever is about to run the script.
action "showcase-step" {
  reason       = "stands in for SCC service enablement: no google_* resource exists for it"
  run          = "../scripts/showcase-action.sh"
  args         = ["--organization", "{customer_organization_id}"]
  execute_args = ["--apply"]
  phase        = "after-apply"
}

// The same step as a Python action, which is the form to write: the extension
// decides how satz launches the file, `.py` runs through `uv run --script` on
// every platform, and a `.sh` does not run on Windows at all.
action "showcase-python-step" {
  reason       = "stands in for a step with no google_* resource, written so it runs on every platform"
  run          = "../scripts/showcase-action.py"
  args         = ["--organization", "{customer_organization_id}"]
  execute_args = ["--apply"]
  phase        = "after-apply"
}

// --- Claims: what this estate proves, and what it declines on purpose. -------
claim "cis-gcp" "4.0" "5.1" implements {
  resources         = ["google_storage_bucket.audit_logs"]
  interpretation    = "Uniform bucket-level access on the audit bucket; no ACL-granted public access is possible."
  duty_public_check = "Confirm public_access_prevention is enforced at the org level."
}

claim "cis-gcp" "4.0" "5.2" contributes {
  resources = ["google_storage_bucket.audit_logs"]
}

claim "cis-gcp" "4.0" "4.4" deviates {
  resources     = ["google_org_policy_policy.compute_managed_requireOsLogin"]
  reason        = "A service here depends on metadata SSH keys; enforcing OS Login breaks it."
  duty_reassess = "Re-assess when that service supports OS Login."
}
