// A bare-list pack: labels at the top level, no type. The estate keys it with
// `use "…" as google_org_policy_policy`. One of the three is suppressed by the
// estate, one is the subject of its `deviates` claim.
pack showcase_policies version "1.0"

// The estate declares a deviation on this control, so the policy it names must
// not enforce — a `deviates` claim over an enforcing policy discloses a
// non-conformance the estate does not have, and `require` reads it as a
// contradicted claim (ADR 0013).
"compute-managed-requireOsLogin" {
  name   = "compute.managed.requireOsLogin"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [ { enforce = "FALSE" } ]
  }
}

"compute-managed-vmExternalIpAccess" {
  name   = "compute.managed.vmExternalIpAccess"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [ { enforce = "TRUE" } ]
  }
}

"iam-managed-disableServiceAccountKeyCreation" {
  name   = "iam.managed.disableServiceAccountKeyCreation"
  parent = "organizations/{customer_organization_id}"
  spec {
    rules = [ { enforce = "TRUE" } ]
  }
}
