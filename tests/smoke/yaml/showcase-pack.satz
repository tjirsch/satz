// A pack with a param default the estate overrides, one resource, and a
// claim that travels with the file (claims are attributed to the pack that
// is actually `use`d — a `.local` fork carries its own).
pack showcase_pack version "1.0"

params {
  pack_bucket_location = "EU"
  // acknowledges the notice below; the estate binds it true once the command has run
  pack_bucket_adopted  = false
}

// A pack may name ONE command to run once it is switched on. satz shows it then, and
// warns at the estate's `use` line until the estate binds `pack_bucket_adopted = true`;
// `before = apply` makes `transpile --apply` and `bootstrap` refuse while it is open.
// The param is an acknowledgement, never emitted: binding it moves no line of the HCL.
notice pack_bucket_adopted {
  text   = "The bucket may already exist in the project — creating it again fails. Import what is live first."
  run    = "satz adopt <estate> --execute --import"
  before = apply
}

// Declared outside a project, so it names the one it belongs in: without `project`
// it would go to the provider block's, and the compile warns about exactly that.
google_storage_bucket {
  pack_bucket {
    project                     = infra_project_name
    name                        = "{customer_shortname}-pack-bucket-001"
    location                    = pack_bucket_location
    uniform_bucket_level_access = true
  }
}

claim "cis-gcp" "4.0" "5.2" contributes {
  resources = ["google_storage_bucket.pack_bucket"]
}

// A pack may ship an executable step. It is reported as coming from a pack on
// every compile, and `--no-pack-actions` skips exactly these.
action "pack-step" {
  reason = "a pack-declared step: enablement the provider has no resource for"
  run    = "../scripts/showcase-action.sh"
  args   = ["--pack", "{customer_shortname}"]
  phase  = "before-apply"
}
