// IaC-roles gate: the six CIS extensions that support a dry run, in their dry-run
// form. It cannot share an estate with `all-packs` — each twin declares the same
// policy address as the enforcing fragment it is derived from, which is the whole
// point: a dry run REPLACES enforcement while it measures, it does not sit beside it.
//
// The twins are generated by `scripts/build_dry_run_fragments.py` from the enforcing
// fragments, so this case also proves the generated output compiles.

estate iac_cis_dry_run

params {
  customer_organization_id = "123456789012"
  customer_id              = "C0example"
  customer_domain          = "example.com"
  customer_shortname       = "acme"
  customer_longname        = "Acme Corp."
  infra_folder_name        = "Infrastructure"
  infra_project_name       = "acme-infra-001"
  infra_bucket_name        = "acme-infra-001-state"
  svc_iac_account          = "svc-iac-001"
  svc_iac_users_group      = "svc-iac-001-users"
  first_admin              = "admin@example.com"
  billing_account_infra    = "012345-6789AB-CDEF01"
  logsink_project_id       = "acme-log-001"
  deployment_engine        = "tofu"
  deployment_mode          = "local"
  default_region           = "europe-west3"
  default_zone             = "europe-west3-a"
  allowed_api_key_services = ["storage.googleapis.com"]
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

use "presets/estate-core.satz"

use "presets/cis/CIS-GCP-Foundation-4.0.satz"

use "presets/cis/api-key-services-dry-run.satz"
use "presets/cis/block-project-ssh-keys-dry-run.satz"
use "presets/cis/bucket-retention-dry-run.satz"
use "presets/cis/cloud-sql-dry-run.satz"
use "presets/cis/cloud-sql-iam-and-deletion-protection-dry-run.satz"
use "presets/cis/confidential-computing-dry-run.satz"
