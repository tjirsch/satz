// IaC-roles gate: every pack in the library that can share one estate, used
// unconditionally, compiled against the corpus schema fixture. Every resource
// type it emits must have a row in the IaC service account's role table
// (`src/prerequisites.rs`). The alternatives that cannot share an estate with these —
// the S1 group model, Defender's least-privilege role — are the other cases under
// `tests/iac/`; together they use every pack.

estate iac_all_packs

params {
  customer_organization_id            = "123456789012"
  customer_id                         = "C0example"
  customer_domain                     = "example.com"
  customer_shortname                  = "acme"
  customer_longname                   = "Acme Corp."
  infra_folder_name                   = "Infrastructure"
  infra_project_name                  = "acme-infra-001"
  infra_bucket_name                   = "acme-infra-001-state"
  svc_iac_account                     = "svc-iac-001"
  svc_iac_users_group                 = "svc-iac-001-users"
  first_admin                         = "admin@example.com"
  billing_account_infra               = "012345-6789AB-CDEF01"
  logsink_project_id                  = "acme-log-001"
  logsink_project_folder              = "google_folder.shared.name"
  deployment_engine                   = "tofu"
  deployment_mode                     = "local"
  default_region                      = "europe-west3"
  default_zone                        = "europe-west3-a"
  allowed_api_key_services            = ["storage.googleapis.com"]
  cis_alert_project                   = "acme-infra-001"
  security_audit_sa_project           = "acme-infra-001"
  mdc_workload_pool_id                = "11111111111111111111111111111111"
  mdc_mgmt_project_id                 = "acme-mdc-001"
  sentinel_workload_pool_id           = "22222222222222222222222222222222"
  sentinel_project_number             = "123456789012"
  scc_siem_subscriber                 = "serviceAccount:sentinel-service-account@acme-infra-001.iam.gserviceaccount.com"
  access_approval_notification_emails = ["security@example.com"]
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

use "presets/estate-core.satz"
use "presets/estate-map.satz"

google_essential_contacts_contact {
  use "presets/essential-contacts-organization.satz"
}

use "presets/cis/CIS-GCP-Foundation-4.0.satz"
use "presets/cis/block-project-ssh-keys.satz"
use "presets/cis/shielded-vm.satz"
use "presets/cis/dns-logging.satz"
use "presets/cis/confidential-computing.satz"
use "presets/cis/cloud-sql.satz"
use "presets/cis/cmek.satz"
use "presets/cis/api-key-services.satz"
use "presets/cis/bucket-retention.satz"
use "presets/cis/access-approval.satz"
use "presets/cis/internet-ssh-rdp.satz"
use "presets/cis/cloud-sql-iam-and-deletion-protection.satz"

use "presets/security-group-models/s2-security-groups.satz"
use "presets/billing-account-permissions.satz"
use "presets/organization-budget.satz"
use "presets/security-audit/sa-security-audit.satz"

// The scaffold's own shape, minus everything the packs already cover: the CIS pack
// claims CIS 5.0 §2.14 against the Cloud Asset API the infrastructure project enables,
// so a fixture built from `estate-core.satz` alone reported that claim BROKEN while
// every real estate satisfies it. `satz init` writes this; a fixture that omits it is
// not testing the estates the library ships for.
google_folder {
  infra_folder {
    display_name = "Infrastructure"
    google_project {
      infra {
        project_id      = infra_project_name
        billing_account = billing_account_infra
        project_service = [
          "cloudasset.googleapis.com",
        ]
      }
    }
  }
}

google_folder {
  shared {
    display_name = "Shared"
  }
}
// The archive project goes in the Shared folder, named by the param rather than by
// where this line stands.
use "presets/monitoring/organization-audit-logsink.satz"
use "presets/monitoring/organization-cis-log-alerts-central.satz"
use "presets/monitoring/project-cis-log-alerts.satz"
use "presets/scc/scc-notifications.satz"
use "presets/scc/scc-findings-mail.satz"
use "presets/scc/scc-findings-siem.satz"
use "presets/scc/scc-export.satz"
use "presets/billing-export.satz"
use "presets/shared-network.satz"

use "presets/integrations/microsoft-defender-for-cloud.satz"
use "presets/integrations/microsoft-sentinel.satz"
use "presets/integrations/microsoft-sentinel-auditlogs.satz"
use "presets/integrations/microsoft-sentinel-network-logs.satz"
use "presets/integrations/microsoft-defender-for-cloud-cspm.satz"
use "presets/integrations/microsoft-defender-for-cloud-cspm-role-default.satz"

use "presets/ci/verification-runner.satz"
use "presets/ci/verification-runner-grant.satz"
use "presets/scc/scc-service-enablement.satz"
use "presets/interface-notice.satz"
