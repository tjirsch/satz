// Satz twin of main.yaml — gated by the differential harness (A must reproduce
// the snapshot).

estate corpus_billing_nested

params {
  customer_organization_id = "123456789"
  billing_account_infra = "01AA-BB-CC"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

google_billing_account_iam_member {
  "group:billing@example.com" = ["roles/billing.admin"]
}

google_folder {
  finance {
    display_name = "Finance"
    google_billing_account_iam_member {
      "group:billing@example.com" = ["roles/billing.admin", "roles/billing.viewer"]
    }
  }
}
