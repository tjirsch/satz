// Satz twin of main.yaml — the differential harness proves it equivalent by
// running pipeline A over THIS file and asserting the existing snapshot.

estate corpus_hoist_two_folders

params {
  customer_organization_id = "123456789"
  customer_id = "C01"
  customer_domain = "example.com"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

google_folder {
  a {
    display_name = "A"
    google_cloud_identity_group {
      "log-admins" { display_name = "Log Admins" }
    }
    google_organization_iam_member {
      "group:log-admins@example.com" = ["roles/logging.admin"]
    }
  }
  b {
    display_name = "B"
    google_cloud_identity_group {
      "log-admins" { display_name = "Log Admins" }
    }
    google_organization_iam_member {
      "group:log-admins@example.com" = ["roles/logging.admin", "roles/monitoring.admin"]
    }
  }
}
