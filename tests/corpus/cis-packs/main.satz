// Corpus case: the CIS coverage extensions, ALL of them on at once. No estate
// would do this — that is the point. It pins the emitted body of each
// constraint, because the three shapes differ and getting one wrong is a policy
// that either does nothing or refuses everything:
//   * a plain managed boolean  -> enforce only
//   * a managed boolean with a parameter -> enforce + parameters
//   * a plain list constraint  -> allow/deny values
// and the three that are not org-policy constraints: the Access Approval
// setting, the hierarchical firewall policy with its rules and association, and
// the Cloud SQL custom constraints, whose policies wait for them (`depends_on`).
// Snapshot-gated.

estate corpus_cis_extensions

params {
  customer_organization_id = "123456789"
  billing_account_infra    = "01AA-BB-CC"
  customer_domain          = "example.com"

  cis_block_project_ssh_keys                = true
  cis_require_shielded_vm                   = true
  cis_confidential_computing                = true
  cis_cloud_sql_hardening                   = true
  cis_cmek_required                         = true
  cis_api_key_services                      = true
  cis_bucket_retention                      = true
  cis_access_approval                       = true
  cis_block_internet_ssh_rdp                = true
  cis_cloud_sql_iam_and_deletion_protection = true

  allowed_api_key_services = [
    "storage.googleapis.com",
  ]
  access_approval_notification_emails = [
    "security@example.com",
  ]
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

use "presets/cis/CIS-GCP-Foundation-4.0.satz"

use "presets/cis/block-project-ssh-keys.satz" when cis_block_project_ssh_keys
use "presets/cis/shielded-vm.satz" when cis_require_shielded_vm
use "presets/cis/dns-logging.satz" when cis_dns_logging
use "presets/cis/confidential-computing.satz" when cis_confidential_computing
use "presets/cis/cloud-sql.satz" when cis_cloud_sql_hardening
use "presets/cis/cmek.satz" when cis_cmek_required
use "presets/cis/api-key-services.satz" when cis_api_key_services
use "presets/cis/bucket-retention.satz" when cis_bucket_retention
use "presets/cis/access-approval.satz" when cis_access_approval
use "presets/cis/internet-ssh-rdp.satz" when cis_block_internet_ssh_rdp
use "presets/cis/cloud-sql-iam-and-deletion-protection.satz" when cis_cloud_sql_iam_and_deletion_protection
