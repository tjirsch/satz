// Corpus case: two packs contribute the same resource-type map inside one
// folder; the fragments don't collide — the fold composes them. Snapshot-gated.

estate corpus_depth_merge

params {
  customer_organization_id = "123456789"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

google_folder {
  logging {
    display_name = "Logging"
    use "pack-a.satz"
    use "pack-b.satz"
  }
}
