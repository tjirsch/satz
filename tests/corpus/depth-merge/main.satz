// Satz twin of main.yaml — gated by the differential harness. The two packs
// contribute the same resource-type map inside one folder: the YAML dialect
// needs the MERGE_KEY_PREFIX rename dance for this; fragments simply don't
// collide — the fold composes them.

estate corpus_depth_merge

params {
  customer_organization_id = "123456789"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

google_folder {
  logging {
    display_name = "Logging"
    use "pack-a.satz"
    use "pack-b.satz"
  }
}
