// Corpus case: a chain of param overrides across packs. Snapshot-gated.

estate corpus_override_chain

params {
  customer_organization_id = "123456789"
  widget_name = "overridden-widget"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

use "pack.satz"
use "optional.satz" when never_defined
