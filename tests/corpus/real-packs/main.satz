// Corpus case: uses the REAL shipped monitoring packs. Snapshot-gated.
//
// It wires NOTHING between them: since alerts pack v1.4 the alert project
// defaults to the logsink pack's own project param, by reference. The snapshot
// is what proves the two packs meet — an estate that had to repeat the project
// name is one rename away from pointing at nothing.

estate corpus_real_packs

params {
  customer_organization_id = "123456789012"
  customer_id              = "C0TEST"
  customer_domain          = "example.com"
  customer_shortname       = "corp"
  default_region           = "europe-west3"
  billing_account_infra    = "01AA-BB-CC"
  logsink_project_id       = "corp-log-infra-001"
}

terraform {
  backend {
    local { path = "terraform.tfstate" }
  }
}

google_folder {
  logging {
    display_name = "Logging"
    use "presets/monitoring/organization-audit-logsink.satz"
    use "presets/monitoring/organization-cis-log-alerts-central.satz"
  }
}
